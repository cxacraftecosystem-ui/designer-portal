  updatedAt DateTime @updatedAt

  questions QuestionnaireQuestion[]
  sectionStatuses QuestionnaireSectionStatus[]

  @@unique([sortOrder])
  @@index([isActive, sortOrder])
}

/// Admin-set completion status for one (artisan, section) cell on the "Check completion" matrix.
/// Absent row = no manual override (the matrix then falls back to data-derived completion). A row
/// here is an explicit verdict by an admin/master admin that overrides the derived green.
model QuestionnaireSectionStatus {
  id        String   @id @default(cuid())
  artisanId String
  sectionId String
  // COMPLETED (green) | NEEDS_REVIEW (yellow) | NEEDS_REDO (red).
  status    String
  setById   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artisan Artisan              @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  section QuestionnaireSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  setBy   User                 @relation("SectionStatusSetBy", fields: [setById], references: [id], onDelete: Restrict)

  @@unique([artisanId, sectionId])
  @@index([sectionId])
  /// The account pointer, indexed for the onDelete action it is on the wrong end of rather than
  /// for a read. See the long note on `DwStageEntry.createdById` for the decision this follows.
  @@index([setById])
}

model QuestionnaireQuestion {
  id          String   @id @default(cuid())
  sectionCode String
  sectionTitle String
  prompt      String
  sortOrder   Int
  isActive    Boolean  @default(true)
  /// When this question stopped being offered. Set together with isActive=false so "retired" is
  /// distinguishable from "an editor unticked it before anyone answered".
  retiredAt   DateTime?
  /// THE QUESTION THAT REPLACED THIS ONE. A plain column and not a Prisma relation, exactly as
  /// QuestionnaireFormQuestion.supersededById is and for the same reason: it is only ever read to
  /// render "replaced by", never joined through, and a self-relation would cost every generated
  /// client an extra recursion level for nothing.
  ///
  /// ── THESE TWO COLUMNS AROUND THE WRONG WAY IS A 500, AND IT SHIPPED THAT WAY FOR A WHILE ──
  ///
  /// The migration that adds them to the database (20260816200000_questionnaire_question_supersede)
  /// and the route that reads and writes them both landed while THIS BLOCK DID NOT — four agents
  /// were editing this file at once and this edit was lost. The generated Prisma client therefore
  /// had no such fields, and three endpoints answered a bare 500: rewording an answered question,
  /// deleting one, and deleting a section holding one.
  ///
  /// That state was strictly WORSE than the defect being fixed. The old behaviour silently rewrote
  /// the wording that existing answers had been given under — bad, and quiet. The half-applied fix
  /// removed the quiet path and put a 500 in its place, so the correction could not be made at all.
  /// If you are ever tempted to land a migration and a route without the model, this is the note.
  ///
  /// What it prevents, stated once: "How many looms?" answered "12", reworded to "How many
  /// weavers?", and a ministry report now states there are twelve weavers. The answers stay on THIS
  /// row under the prompt they were given, and the new wording becomes a new row.
  supersededById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sectionId   String?

  section   QuestionnaireSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  responses QuestionnaireResponse[]

  @@index([sectionCode])
  @@index([sectionId])
  @@index([isActive])
  @@index([supersededById])
}

model QuestionnaireInterview {
  id            String       @id @default(cuid())
  title         String
  interviewDate DateTime?
  place         String?
  language      String?
  notes         String?
  status        RecordStatus @default(PENDING)
  /// Review audit, identical to every other reviewable record. These were MISSING here while
  /// Artisan/Workshop/Product/Tool/Process/Media all had them, so the moment interviews became
  /// reviewable every approve raised
  ///   FieldNotFoundError: Could not find field at `updateOneQuestionnaireInterview.data.reviewNotes`
  /// which escaped as a bare 500 ("Failed to fetch" in the browser, HTTP 500 on Android).
  reviewNotes   String?
  reviewedById  String?
  reviewedAt    DateTime?
  extraMetadata Json?
  recordedAt    DateTime     @default(now())
  recordedTimezone String    @default("Asia/Kolkata")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  createdById   String
  locationId    String?
  // Deterministic key for the exact set of artisans this interview covers (sorted, comma-joined
  // artisan ids). Enforces ONE interview per artisan set: creation is idempotent on this key, so
  // every client lands on the single canonical entry instead of spawning duplicates. NULL only when
  // an interview has no artisans (those are not deduped). A subset is a different set => different key.
  artisanSetKey String?      @unique
  /// The workshop this interview was conducted at, named EXPLICITLY on the record — previously an
  /// interview had no path to a workshop at all. Nullable, so every interview recorded before this
  /// column keeps behaving exactly as before.
  workshopId    String?

  createdBy User                             @relation("QuestionnaireCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  location  Location?                        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  workshop  Workshop?                        @relation("InterviewWorkshop", fields: [workshopId], references: [id], onDelete: SetNull)
  artisans  QuestionnaireInterviewArtisan[]
  responses QuestionnaireResponse[]
  media     MediaFile[]                      @relation("QuestionnaireMedia")

  @@index([createdById])
  @@index([status])
  @@index([interviewDate])
  @@index([workshopId, createdAt])
  @@index([createdAt])
}

model QuestionnaireInterviewArtisan {
  interviewId String
  artisanId   String
  createdAt   DateTime @default(now())

  interview QuestionnaireInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  artisan   Artisan                @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@id([interviewId, artisanId])
  @@index([artisanId])
}

model QuestionnaireResponse {
  id          String   @id @default(cuid())
  interviewId String
  questionId  String
  answerText  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  answeredById String

  interview  QuestionnaireInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question   QuestionnaireQuestion  @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answeredBy User                   @relation("QuestionnaireAnsweredBy", fields: [answeredById], references: [id], onDelete: Restrict)

  @@unique([interviewId, questionId])
  @@index([questionId])
  @@index([answeredById])
}

// ------------------------------------------------------------------------------------------------
// Custom questionnaires: a form a DESIGNER authored themselves, from the downloadable .xlsx
// pro-forma, and the answers recorded against it in the app.
//
// WHY THESE ARE FOUR NEW TABLES RATHER THAN A NULLABLE `questionnaireId` ON QuestionnaireSection /
// QuestionnaireQuestion. That was the obvious extension and it was rejected for two concrete
// reasons, both of which would have shipped as bugs:
//
//  1. IT WOULD HAVE SILENTLY DESTROYED THE GLOBAL QUESTIONNAIRE'S UNIQUENESS. QuestionnaireSection
//     carries `code @unique` and `@@unique([sortOrder])`. Making those composite with a NULLABLE
//     questionnaireId does not scope them — in Postgres, NULLs are DISTINCT in a unique index, so
//     `UNIQUE(questionnaireId, sortOrder)` enforces NOTHING AT ALL across the rows where
//     questionnaireId IS NULL, which is every row of the global questionnaire. The constraint that
//     stops two sections landing on position 3 would have been dropped in all but name, and
//     `reorder_sections` in the route depends on it holding.
//
//  2. CUSTOM SECTIONS WOULD HAVE LEAKED INTO SCREENS THAT ARE NOT ABOUT THEM. Four queries outside
//     this feature read QuestionnaireSection with no questionnaire filter and would have started
//     returning a designer's private sections: the task-assignment picker and task hydration in
//     api/routes/tasks.py (three sites), the per-artisan consolidation + CSV export in
//     services/questionnaire_consolidation.py, and the completion matrix. An admin assigning
//     fieldwork would have been offered "Section 2 — Loom preferences" from one designer's private
//     form as a documentation task for an artisan who has never seen it.
//
// The price of separate tables is that answers do not reuse QuestionnaireInterview. That turns out
// to be a second reason rather than a cost: an interview REQUIRES a location, carries a unique
// artisanSetKey enforcing one interview per artisan set, and goes through the review queue. A
// designer answering their own eight-question form has no artisans, no location and nothing to
// review, and would have had to invent all three to save a single answer.
// ------------------------------------------------------------------------------------------------

/// One custom questionnaire: the designer's own instrument, uploaded as .xlsx and answered in-app.
///
/// `version` is NOT a schema version — it is the count of DESTRUCTIVE-ish edits applied after the
/// first answer existed (a supersede or a retire). A client caches a form and needs to know its
/// copy is stale; comparing this integer is cheaper than diffing the question list.
model Questionnaire {
  id          String  @id @default(cuid())
  title       String
  description String?
  ownerId     String
  /// The workshop this questionnaire is attached to, set from the designer's dropdown. NULL means
  /// "not attached yet" — a designer builds the form before deciding which workshop it belongs to,
  /// and a questionnaire outlives the workshop it was used at (onDelete: SetNull, never Cascade:
  /// deleting a workshop must not take a fortnight of recorded answers with it).
  designWorkshopId String?
  isActive    Boolean @default(true)
  version     Int     @default(1)
  /// The name of the .xlsx it was uploaded from, shown so a designer can tell two drafts apart.
  sourceFilename String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner          User            @relation("QuestionnaireOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  designWorkshop DesignWorkshop? @relation("DesignWorkshopQuestionnaires", fields: [designWorkshopId], references: [id], onDelete: SetNull)
  sections QuestionnaireFormSection[]
  entries  QuestionnaireFormEntry[]

  @@index([ownerId, createdAt])
  @@index([designWorkshopId])
  @@index([isActive, createdAt])
}

/// A section of a custom questionnaire. `code` is unique WITHIN its questionnaire and nowhere else —
/// two designers both naming a section "A" is normal and must not collide.
model QuestionnaireFormSection {
  id              String  @id @default(cuid())
  questionnaireId String
  code            String
  title           String
  sortOrder       Int
  /// Retired rather than deleted once any question under it has been answered. See
  /// services/questionnaire_forms.py for the rule and why.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questionnaire Questionnaire              @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  questions     QuestionnaireFormQuestion[]

  /// Scoped uniqueness, with NO nullable column in the key — which is exactly what the rejected
  /// nullable-questionnaireId design could not give the global questionnaire.
  @@unique([questionnaireId, code])
  @@index([questionnaireId, sortOrder])
}

/// One question. Once it has an answer it becomes effectively IMMUTABLE — see `supersededById`.
model QuestionnaireFormQuestion {
  id         String  @id @default(cuid())
  sectionId  String
  prompt     String
  helpText   String?
  isRequired Boolean @default(false)
  sortOrder  Int
  isActive   Boolean @default(true)
  /// When this question stopped being offered. Set together with isActive=false so "retired" is
  /// distinguishable from "the designer unticked it before anyone answered".
  retiredAt  DateTime?
  /// THE QUESTION THAT REPLACED THIS ONE. A deliberately PLAIN COLUMN, not a Prisma relation: it is
  /// only ever read to render "replaced by", never joined through, and a self-relation here would
  /// cost every generated client an extra recursion level for nothing.
  ///
  /// Set when a designer rewrites the prompt of a question that already has answers. The recorded
  /// answers stay attached to THIS row with the prompt they were given under, and the new wording
  /// becomes a new row. The failure this prevents: "How many looms?" answered "12", reworded to
  /// "How many weavers?", and a ministry report now states there are twelve weavers.
  supersededById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section QuestionnaireFormSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answers QuestionnaireFormAnswer[]

  @@index([sectionId, sortOrder])
  @@index([isActive])
  @@index([supersededById])
}

/// ONE FILLED-IN COPY of a questionnaire — a sitting, a respondent, a session. A questionnaire can
/// be answered many times over (five artisans, five entries), so answers hang off this and not off
/// the questionnaire directly.
///
/// Answers that arrived ALREADY FILLED IN inside an uploaded .xlsx land here too, as an entry with
/// `source = "UPLOAD"`. That is what keeps there from being two different notions of "an answer":
/// the file's answers and the app's answers are the same rows, so the edit rules below apply to
/// both without a special case.
model QuestionnaireFormEntry {
  id              String  @id @default(cuid())
  questionnaireId String
  title           String
  respondentName  String?
  /// APP (typed into the platform) | UPLOAD (came in already answered on the spreadsheet).
  source          String  @default("APP")
  notes           String?
  createdById     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questionnaire Questionnaire             @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  createdBy     User                      @relation("QuestionnaireFormEntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  answers       QuestionnaireFormAnswer[]

  @@index([questionnaireId, createdAt])
  @@index([createdById])
}

model QuestionnaireFormAnswer {
  id           String  @id @default(cuid())
  entryId      String
  questionId   String
  answerText   String?
  notes        String?
  answeredById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entry      QuestionnaireFormEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  /// RESTRICT, and this is the enforcement point for the whole edit-after-answers rule. The service
  /// layer refuses to delete an answered question, but a rule that lives only in Python is one
  /// `delete_many` away from orphaning a designer's recorded fieldwork. The database refuses too.
  question   QuestionnaireFormQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answeredBy User                      @relation("QuestionnaireFormAnsweredBy", fields: [answeredById], references: [id], onDelete: Restrict)

  /// One answer per question per sitting; re-saving updates rather than appends.
  @@unique([entryId, questionId])
  @@index([questionId])
  @@index([answeredById])
}

model Process {
  id                  String       @id @default(cuid())
  name                String
  preProcessAvailable Boolean      @default(false)
  notes               String?
  status              RecordStatus @default(PENDING)
  reviewNotes         String?
  reviewedById        String?
  reviewedAt          DateTime?
  extraMetadata       Json?
  recordedAt          DateTime     @default(now())
  recordedTimezone    String       @default("Asia/Kolkata")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  productId           String
  createdById         String
  /// The workshop this process was documented at, named EXPLICITLY on the record. A process used to
  /// reach a workshop only through its parent product; both readings still work, and this column is
  /// nullable so every row recorded before it keeps behaving exactly as before.
  workshopId          String?

  product   ProductDocumentation @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User                 @relation("ProcessCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  workshop  Workshop?            @relation("ProcessWorkshop", fields: [workshopId], references: [id], onDelete: SetNull)
  steps     ProcessStep[]

  @@index([productId])
  @@index([createdById])
  @@index([status])
  @@index([workshopId, createdAt])
  @@index([createdAt])
}

model ProcessStep {
  id        String          @id @default(cuid())
  processId String
  name      String
  stepType  ProcessStepType @default(SEQUENTIAL)
  sortOrder Int
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
}

model ReviewLog {
  id         String           @id @default(cuid())
  recordType ReviewRecordType
  recordId   String
  status     RecordStatus
  notes      String?
  reviewerId String
  createdAt  DateTime         @default(now())

  reviewer User @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([recordType, recordId])
  @@index([reviewerId])
  @@index([createdAt])
}

// Singleton row (id = "singleton") holding master-admin-configurable global settings. For now: how
// audio transcripts are produced (raw / refined / refined+translated) and an optional off-peak window
// during which the heavy transcription+refinement work runs, so it doesn't compete with daytime
// uploads. Extend with more configurable fields over time.
model AppSetting {
  id                 String   @id @default("singleton")
  transcriptionMode  String   @default("REFINED_TRANSLATED")
  /// Speech-to-text providers in the order the master admin ranked them. One with no configured key
  /// is skipped where it sits, so this ranks preference and never gates transcription.
  sttProviderOrder   String[] @default(["elevenlabs", "deepgram", "whisper"])
  batchWindowEnabled Boolean  @default(false)
  batchWindowStart   String   @default("02:00")
  batchWindowEnd     String   @default("05:00")
  batchTimezone      String   @default("Asia/Kolkata")

  /// How many server dictations ONE DESIGNER may spend per India-time day. Plan §6.1's cost ceiling.
  ///
  /// **NULL MEANS UNCAPPED AND 0 MEANS REFUSE EVERY ONE. Both are real settings and neither is a
  /// "not set" sentinel**, which is stated here because a reader who guesses will guess wrong in the
  /// expensive direction. NULL is today's behaviour, so the migration that adds this column changes
  /// nothing on deploy; 0 turns the server dictation rung off entirely and the refusal says so.
  ///
  /// **THE DEFAULT IS NULL BECAUSE THE RIGHT NUMBER IS UNMEASURED, IN THAT WORD.** Nothing in this
  /// repository measures dictations per designer per day, and a placeholder shipped here would become
  /// the number on the settings screen. What IS known bounds it rather than choosing it: 510 field
  /// specs in the registry as counted today (the "496" repeated in older comments and in the plan is
  /// stale), a 6 MB per-clip ceiling (DICTATION_MAX_BYTES), and a four-minute recorder limit at
  /// 32 kbit/s which is about 960 KB per clip. The first real number is a deliberate decision for
  /// whoever sees the first bill.
  ///
  /// ON THE MASTER-ADMIN SETTINGS ROW, and not in deploy-time env, because the whole point of the
  /// number is that it is adjustable the day the bill arrives — an env var would need a redeploy. And
  /// not narrowed to a lower rank the way the STT provider RANKING deliberately is: that is "an
  /// editorial call about accuracy on Hindi and regional speech" and belongs to the admins who run
  /// workshops, while a spend ceiling is a cost decision of exactly the kind the off-peak batch window
  /// three lines above already is.
  dwDictationDailyCap Int?

  /// How many AI-VERB runs — proofread, expand, translate, caption, subtitle — ONE DESIGNER may
  /// spend per India-time day, across all five together.
  ///
  /// **A SECOND CEILING AND NOT A SECOND USE OF THE ONE ABOVE, and the separation is a decision.**
  /// Plan §6.1 settled that cap's scope in the user's own words: it "should only apply to the global
  /// /dictate when it is utilizing the ElevenLabs / Deepgram / Whisper API". Counting a caption
  /// against it would make the refusal a designer reads — "you have used all 40 of today's
  /// dictations that go to the transcription service" — false on a day spent captioning photographs
  /// at a desk, and would let desk work withdraw a control somebody needs in a courtyard. The bills
  /// are different too: a chat completion is priced per token, a dictation per second of audio, so
  /// one number cannot bound both.
  ///
  /// NULL MEANS UNCAPPED AND 0 MEANS REFUSE EVERY RUN, exactly as its sibling, and neither is a "not
  /// set" sentinel. NULL ships, because the right number is UNMEASURED in that word: nothing in this
  /// repository has ever measured verb runs per designer per day, and a placeholder here would
  /// become the number on the settings screen.
  dwAiVerbDailyCap Int?

  updatedAt          DateTime @updatedAt
  updatedById        String?
}

/// A workshop-to-researcher assignment made by an admin. Only researchers assigned to a workshop may
/// create records tied to it, and a submission made outside the workshop's [startDate, endDate] window
/// is flagged as needing admin approval. A workshop with NO assignment rows is open to everyone
/// (backward compatible with data created before assignments existed).
/// Who may work in a workshop, and at what level.
///
/// One row covers BOTH directions of the same relationship, because they settle into the same
/// state: an admin granting access to somebody, and a newly-onboarded user asking for it. The
/// difference is only where the row starts — an admin's grant begins GRANTED, a self-request begins
/// PENDING and needs an admin decision — so a single table means the grant list and the request
/// queue can never disagree about who currently has access.
model WorkshopAssignment {
  id           String   @id @default(cuid())
  workshopId   String
  userId       String
  assignedById String?
  /// VIEW (read the workshop's data), CONTRIBUTE (add records), EDIT (change anyone's records here).
  /// Ordered, so a check is a rank comparison rather than a set membership test.
  accessLevel  String   @default("CONTRIBUTE")
  /// PENDING (requested, awaiting an admin) / GRANTED / DENIED / REVOKED. Only GRANTED confers
  /// access; DENIED and REVOKED are kept rather than deleted so the decision stays auditable and a
  /// user cannot silently re-request their way around a refusal.
  status       String   @default("GRANTED")
  /// Set when the row began as the user's own request, so the queue can tell the two apart.
  requestedById String?
  requestNote  String?
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workshop    Workshop @relation("WorkshopAssignments", fields: [workshopId], references: [id], onDelete: Cascade)
  user        User     @relation("WorkshopAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy  User?    @relation("WorkshopAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  requestedBy User?    @relation("WorkshopAssignmentRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy   User?    @relation("WorkshopAssignmentDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  // The unique below is the workshop-roster lookup `resolve_workshop_access` makes on every
  // workshop-scoped write; a separate [workshopId] would only duplicate its leading column.
  @@unique([workshopId, userId])
  @@index([userId])
  @@index([status])
  /// The account pointer, indexed for the onDelete action it is on the wrong end of rather than
  /// for a read. See the long note on `DwStageEntry.createdById` for the decision this follows.
  @@index([assignedById])
  @@index([requestedById])
  @@index([decidedById])
}

/// A runtime-editable API key or service credential.
///
/// Keys used to live only in the EC2 `.env`, so rotating one meant an SSH session and a restart —
/// and nobody but the person holding the server could see whether a provider was even configured.
/// A master admin can now read (redacted), set and rotate them from the Settings hub, and the
/// services read through `services/managed_secrets.py`, which prefers a stored value and falls back
/// to the environment. That fallback is what makes this safe to deploy: an empty table behaves
/// exactly like today.
///
/// `value` is encrypted at rest with Fernet (see managed_secrets.py) rather than stored in the
/// clear, because a database dump of provider keys is a far worse leak than a config file on one
/// box. It is NEVER returned to a client in full — only a masked preview plus a reachability check.
model ManagedSecret {
  id          String   @id @default(cuid())
  /// The environment-variable name this overrides, e.g. "OPENAI_API_KEY".
  key         String   @unique
  /// Fernet ciphertext. Never logged, never serialised to a response.
  valueEnc    String
  /// Last four characters of the plaintext, so the UI can show "…a4f2" without decrypting.
  hint        String?
  description String?
  /// Result of the most recent reachability probe: UNKNOWN / OK / FAILED.
  lastStatus  String   @default("UNKNOWN")
  lastCheckedAt DateTime?
  lastError   String?
  updatedById String?
  updatedBy   User?    @relation("ManagedSecretUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// The account pointer, indexed for the onDelete action it is on the wrong end of rather than
  /// for a read. See the long note on `DwStageEntry.createdById` for the decision this follows.
  @@index([updatedById])
}

/// ONE DESIGNER'S OWN KEY for one provider, encrypted with the same Fernet as ManagedSecret.
///
/// SEPARATE FROM ManagedSecret ON PURPOSE, and the separation is a permission boundary rather than
/// tidiness. A ManagedSecret is the DEPLOYMENT's key: one row per provider, written only by the
/// master admin from the Settings hub, and used by every request the server serves. A row here is
/// ONE PERSON's key, readable and writable only by that person, and used only for work they
/// themselves ask for. Putting both in one table would mean one careless `find_unique(where={"key":
/// ...})` served somebody else's credential to a provider on somebody else's behalf — and the
/// billing for that lands on a real person's card.
///
/// `model` is the designer's chosen model id, validated against `services/ai_providers` at write
/// time. It is nullable: a key with no model chosen runs the provider's default, which is what
/// somebody who pasted a key and pressed Save expects.
model UserAiCredential {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("UserAiCredentialOwner", fields: [userId], references: [id], onDelete: Cascade)
  /// OPENAI | GEMINI | ANTHROPIC — the AiProvider enum in services/ai_providers.
  provider      String
  /// Fernet ciphertext. Never logged, never serialised to a response, never revealed — unlike a
  /// ManagedSecret there is no reveal endpoint for these, because no administrator has any business
  /// reading a designer's personal credential.
  valueEnc      String
  /// Last four characters of the plaintext, so the owner can tell two of their own keys apart.
  hint          String?
  /// The chosen model id. NULL means "the provider's default", resolved at call time so that a
  /// default which moves does not leave every designer pinned to a retired model.
  model         String?
  /// Result of the most recent reachability probe: UNKNOWN / OK / FAILED.
  lastStatus    String   @default("UNKNOWN")
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// One key per provider per person. A designer with two OpenAI keys has no way to say which one
  /// a given job should use, so the second replaces the first.
  @@unique([userId, provider])
  @@index([userId])
}

/// The verdict of the last "Test" of a provider key that lives in the deployed ENVIRONMENT.
///
/// WHY A SECOND TABLE. ManagedSecret is where a verdict belongs, but a row there only exists once
/// somebody SAVES a key through the Settings hub, and its whole purpose is to be an override — the
/// resolver prefers it over the environment. So recording an environment key's verdict by creating
/// one would copy the deployed secret into the database and change which value the transcription
/// chain uses, to persist a boolean. This table holds the boolean and nothing else, and it
/// overrides nothing. On production, where every key comes from the environment, it is the
/// difference between the provider ranking remembering what has been proven and resetting to
/// "nothing verified" on every deploy.
///
/// THE VALUE IS NOT HERE, IN ANY FORM. Not the key, not a prefix, not a digest of it. `fingerprint`
/// is HMAC-SHA256 of the value under a server-side pepper derived from SECRETS_ENCRYPTION_KEY (or
/// JWT_SECRET), so it cannot be computed, reversed or brute-forced from a database dump alone — the
/// pepper is not in the database. It exists for exactly one purpose: a rotated key must not inherit
/// the old key's pass. On a mismatch the verdict is ignored and the engine reads as untested, which
/// is also what happens if the pepper itself changes, i.e. the failure direction is "prove it
/// again" rather than "trust something unproven".
model SecretTestResult {
  /// The environment-variable name, e.g. "ELEVENLABS_API_KEY". One verdict per key.
  key         String   @id
  /// OK or FAILED. There is no UNKNOWN: a row exists only because a test was actually run.
  status      String
  checkedAt   DateTime
  /// The probe's short, redacted explanation of a failure. Never a provider response body.
  error       String?
  fingerprint String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Tiered data-access sharing between researchers. OWNER = the author whose uploaded records are being
/// shared; GRANTEE = the researcher who receives access at `tier` (DOWNLOAD < COMMENT < EDIT). Exactly
/// one row per (owner, grantee) pair: status PENDING is an outstanding request raised by the grantee;
/// GRANTED is active. `allData` true covers everything the owner uploaded; otherwise the covered set is
/// the explicit `scopeItems` subset.
model DataAccessGrant {
  id            String           @id @default(cuid())
  ownerId       String
  granteeId     String
  tier          DataAccessTier   @default(DOWNLOAD)
  status        DataAccessStatus @default(PENDING)
  allData       Boolean          @default(true)
  requestNote   String?
  decisionNote  String?
  requestedById String?
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  owner       User  @relation("DataAccessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  grantee     User  @relation("DataAccessGrantee", fields: [granteeId], references: [id], onDelete: Cascade)
  requestedBy User? @relation("DataAccessRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy   User? @relation("DataAccessDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  scopeItems  DataAccessScopeItem[]

  // [granteeId] stands alone because it is NOT the leading column of the unique, and it is the hot
  // one: `records.owned_or_granted_where` reads this table by grantee on every download and export
  // request from below professor. (It used to ride every LIST request too, under the older name
  // `visibility_where`, before reading the repository was opened to every signed-in account.)
  @@unique([ownerId, granteeId])
  @@index([granteeId])
  @@index([status])
  /// The account pointer, indexed for the onDelete action it is on the wrong end of rather than
  /// for a read. See the long note on `DwStageEntry.createdById` for the decision this follows.
  @@index([requestedById])
  @@index([decidedById])
}

/// One record in the subset covered by a non-allData DataAccessGrant.
model DataAccessScopeItem {
  id         String   @id @default(cuid())
  grantId    String
  recordType String
  recordId   String
  createdAt  DateTime @default(now())

  grant DataAccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@unique([grantId, recordType, recordId])
}

/// A comment on any record (generic over recordType/recordId), left by the record owner, an admin, or a
/// user holding COMMENT-tier-or-higher data access to the owner.
model EntryComment {
  id         String   @id @default(cuid())
  recordType String
  recordId   String
  authorId   String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author User @relation("EntryCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([recordType, recordId])
  @@index([authorId])
}

/// An immutable audit row capturing one edit to a record's fields. `changes` is a JSON object shaped
/// {field: {old, new}}. Recorded whenever a record's fields change through the contribute path so an
/// admin can reconstruct the original values alongside every subsequent edit and see who made each one.
model RecordRevision {
  id         String   @id @default(cuid())
  recordType String
  recordId   String
  editedById String?
  changes    Json
  createdAt  DateTime @default(now())

  editedBy User? @relation("RecordRevisionEditedBy", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([recordType, recordId])
  @@index([editedById])
}

// ======================================================================================
// Design & Prototype Workshop
// ======================================================================================
//
// The 22-stage capture defined by the source requirements document, stored as a HYBRID: a
// typed `DesignWorkshop` header carrying only what a list, a filter and a sort actually read,
// plus one `DwStageEntry` row per record whose `data` is a JSON object keyed by the field keys
// declared in `app/services/stage_schema.py`.
//
// The alternative shapes were both worse. Two and a half thousand typed columns would make
// every new Standard-tier field a migration in the middle of a workshop season — and the
// reviewer's own comments on the source document ("some of these could be optional fields",
// "later we can refine") say plainly that the field list is not finished. A pure JSON document
// per workshop, on the other hand, cannot answer "every Ikat workshop in Odisha in 2026"
// without reading every row.
//
// So the registry is the schema, and the columns below are an INDEX over it. `promoted_values`
// in stage_schema.py is the single writer of the denormalised columns; nothing else may set
// them, or the two readings drift.

/// Where a design workshop is in its life. Deliberately NOT `RecordStatus`: that enum models a
/// review queue (PENDING -> APPROVED/REJECTED), and a workshop is not reviewed, it is run. A
/// workshop can also be ARCHIVED long after it is COMPLETE, which the review enum cannot say.
enum DesignWorkshopStatus {
  DRAFT
  IN_PROGRESS
  COMPLETE
  SUBMITTED
  ARCHIVED
}

/// May the recordings and dictation from ONE workshop leave the device for a third-party
/// transcription provider? Plan §6 answer 3, and the answer is per workshop rather than per account.
///
/// THREE STATES, NOT A BOOLEAN, and the third one is the whole reason this is an enum. "Nobody has
/// asked the artisan yet" and "the artisan said no" both stop a recording being sent, but they are
/// different facts with different next moves: the first is answered by asking, the second only by
/// the artisan changing their mind. A boolean would collapse them, and every workshop in the
/// database on the day the column lands is in the FIRST state — so a boolean would have had to
/// default to false and would then be indistinguishable from thirty thousand refusals nobody ever
/// made.
///
/// AN ACCOUNT-LEVEL SETTING WAS REJECTED, and the reason is worth having here rather than only in the
/// plan: a consent given for one cluster would silently cover the next one, and the artisan whose
/// voice it is changes between them. One designer works six clusters in a season.
enum DwDictationConsent {
  NOT_RECORDED
  GRANTED
  REFUSED
}

model DesignWorkshop {
  id         String               @id @default(cuid())
  title      String
  templateId String               @default("DCH_STANDARD")
  status     DesignWorkshopStatus @default(DRAFT)

  // Denormalised from stage 1 by promoted_values(). Never written by hand; see the note above.
  workshopCode       String?
  scheme             String?
  craftName          String?
  clusterName        String?
  state              String?
  district           String?
  venue              String?
  startDate          DateTime?
  endDate            DateTime?
  designerName       String?
  implementingAgency String?
  sponsor            String?

  notes String?

  /// The digest of the field registry this record was last written against. A phone that syncs
  /// a draft written under an older registry is detectable here, which is what lets a migration
  /// run once rather than being guessed at on every read.
  schemaVersion String?

  /// ==================================================================================
  /// TIER 3 CONSENT: may THIS workshop's recordings leave the device? Plan §6 answer 3.
  /// ==================================================================================
  ///
  /// **COLUMNS AND A LOG, AND DELIBERATELY NOT A REGISTRY FIELD.** A consent question added to
  /// stage 1 as a `FieldSpec` was the obvious-looking home and it is wrong in five independent
  /// ways, any one of them sufficient. The decisive one is that a stage field CANNOT CARRY WHO AND
  /// WHEN, which is the entire content of this decision: `save_stage`'s UPDATE branch writes exactly
  /// {data, ordinal, deletedAt}, `DwStageEntry.createdById` is set on the CREATE branch alone, and
  /// `DwStageEntry.updatedAt` is `@updatedAt` and moves whenever ANY field in that stage's row
  /// changes. A consent stored there would be attributed to whoever first saved stage 1 and dated to
  /// the last edit of any of stage 1's forty fields.
  ///
  /// The other four: it would move `registry_version()`, which is the refetch signal for a file
  /// compiled into the APK, so every handset in the fleet would treat its bundled 119 KB schema as
  /// stale; it would therefore force an Android release, because two tests pin the digest AND the
  /// full `registry_to_dict()` content to that asset; `custom_sections.py` already wrote the rule
  /// down for the immediately preceding feature ("`registry_to_dict()` gains nothing — not a key, not
  /// a flag, not one string"); and it would move every existing workshop's completeness, because the
  /// scorer counts every non-deprecated singleton field into requiredTotal/optionalTotal. A column
  /// touches no score at all.
  ///
  /// See `app/services/dictation_consent.py` for what the three columns mean together and for the
  /// gate they feed.
  dictationConsent DwDictationConsent @default(NOT_RECORDED)

  /// WHEN THE ARTISAN ANSWERED — not when this server heard about it, and the difference is a
  /// fortnight in the field. A consent recorded in a courtyard reaches the server on the next sync,
  /// so a client that answered offline sends the moment it happened and it lands here. When the
  /// server hears it is `DwWorkshopConsentDecision.createdAt`, which is that table's own clock, and
  /// both are kept because they answer different questions. Null while `dictationConsent` is
  /// NOT_RECORDED: there is no moment, and now() would fabricate one.
  dictationConsentAt DateTime?

  /// WHO answered — the account that recorded the artisan's answer. Nullable so the relation below
  /// can be SetNull.
  dictationConsentById String?

  // The daily dictation cap is deliberately NOT a column here. It is per DESIGNER (plan §6.1), so
  // the counter hangs off `User` and is keyed by (userId, istDay) — see DwDictationDailyUsage.


  /// Set when a workshop is deleted. NOTHING in this table is hard-deleted: this is a research
  /// data set, the repo has no soft delete anywhere else, and a designer's two weeks of
  /// fieldwork is not something a mis-tap should end. Every read filters on `deletedAt: null`.
  deletedAt   DateTime?
  deletedById String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  /// Optional link to the Workshop record the rest of the repository already knows about, so a
  /// design workshop held at a documented workshop shares its artisans and location instead of
  /// restating them.
  workshopId String?

  createdBy User            @relation("DesignWorkshopCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  deletedBy User?           @relation("DesignWorkshopDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  workshop  Workshop?       @relation("DesignWorkshopWorkshop", fields: [workshopId], references: [id], onDelete: SetNull)
  entries   DwStageEntry[]
  exports   DwReportExport[]
  /// What models produced from this workshop's material, never mixed into `entries`. A layer is
  /// annexure content and a suggestion; a stage entry is what the designer wrote. See DwAiLayer.
  aiLayers  DwAiLayer[]      @relation("DesignWorkshopAiLayers")
  /// The colleagues an admin has let into this workshop besides `createdBy`. See
  /// `DesignWorkshopViewer` for why the creator is not the whole team.
  viewers   DesignWorkshopViewer[] @relation("DesignWorkshopViewers")
  /// The people who have ASKED to be let in and have not been, plus the settled history of every
  /// ask ever answered. A separate table from `viewers` on purpose — a grant is current fact and is
  /// deleted when it ends, an ask and its refusal are history and are kept. See
  /// `DesignWorkshopAccessRequest`.
  accessRequests DesignWorkshopAccessRequest[] @relation("DesignWorkshopAccessRequests")
  /// Custom questionnaires attached to this workshop through the designer's dropdown. Nullable on
  /// the far side, so an unattached questionnaire is a first-class thing rather than an orphan.
  questionnaires Questionnaire[] @relation("DesignWorkshopQuestionnaires")
  /// Questions this workshop's designer added to it without a deployment. The DEFINITION is here;
  /// the ANSWERS are `entries` rows under the reserved entityKey "_custom". See DwCustomSection.
  customSections DwCustomSection[] @relation("DesignWorkshopCustomSections")

  /// SetNull, exactly as `DwAiLayer.acceptedById` is and for the same stated reason: the three
  /// columns above are a CACHE of the current answer, and the record of the ACT is
  /// `DwWorkshopConsentDecision`, whose actor is Restrict. So SetNull here is not what lets the
  /// account go — anybody who has ever recorded a consent is undeletable for as long as that log
  /// stands, and the admin is told so as a sentence. What it buys is narrower and still worth
  /// having: if such an account is ever removed by hand, the workshop keeps its answer with an empty
  /// name ("consented, recorded by somebody no longer on record") instead of the delete failing
  /// halfway or the consent silently reverting to NOT_RECORDED and re-enabling a third-party send.
  dictationConsentBy User? @relation("DesignWorkshopDictationConsentBy", fields: [dictationConsentById], references: [id], onDelete: SetNull)

  /// Every consent answer this workshop has ever carried, in order. The columns above say what the
  /// answer IS; this says what it has BEEN, which is the only way "granted on the 3rd, withdrawn on
  /// the 9th" is answerable at all.
  dictationConsents DwWorkshopConsentDecision[] @relation("DesignWorkshopDictationConsents")
  /// Every peer- and pool-round rating filed against this workshop's sketches and prototypes.
  /// Denormalised onto the rating so the level-1 review page needs no join; see DwReviewRating.
  reviewRatings     DwReviewRating[]            @relation("DesignWorkshopReviewRatings")

  // The list's default order, and the two filters a researcher reaches for first.
  @@index([createdAt])
  @@index([startDate])
  @@index([createdById])
  @@index([status])
  @@index([craftName])
  @@index([state, district])
  @@index([workshopId])
  @@index([deletedAt])
  /// Indexed for the WRITE it is on the wrong end of rather than for any read: `dictationConsentById`
  /// is ON DELETE SET NULL, so deleting a user makes Postgres find every workshop naming them, and
  /// without this that is a sequential scan of the workshop table inside a request an admin is
  /// waiting on. The same reasoning as `DwAiLayer`'s three account indexes.
  @@index([dictationConsentById])
  /// The account pointer, indexed for the onDelete action it is on the wrong end of rather than
  /// for a read. See the long note on `DwStageEntry.createdById` for the decision this follows.
  @@index([deletedById])
}

/// Who, besides the person who pressed "create", may open one design & prototype workshop.
///
/// A REAL WORKSHOP HAS A TEAM. Two designers, a master craftsperson and a reviewing officer work
/// the same fortnight, and until this table existed the record was visible to exactly one account:
/// `load_workshop_or_404` admitted `createdById` and admins and nobody else. A colleague could not
/// open the workshop at all, and a designer who left mid-season took their fieldwork with them —
/// there was no handover short of an admin editing the database.
///
/// WHAT IS BORROWED FROM `WorkshopAssignment`, and what deliberately is not. The shape is the same:
/// one row per (record, user), unique on the pair, `@@index([userId])` for the reverse question,
/// admin-only administration, and a whole-set PUT that replaces the roster. The request/approve
/// LIFECYCLE is not — there is no `status`, no `requestedById`, no `decidedAt`. This row is a
/// GRANT and nothing else: it is only ever written by an admin, so four of the five lifecycle
/// columns would sit permanently at 'GRANTED' if they were here.
///
/// ⚠ THIS DOCSTRING USED TO CONTINUE "Nothing asks for a design workshop", AND THAT IS NO LONGER
/// TRUE. `DesignWorkshopAccessRequest` below is the queue it said did not exist — a designer who
/// scanned a workshop's card can now ask, because every route that could put them on a workshop is
/// admin-only and until that table landed there was no endpoint through which they could even ask.
/// The sentence is corrected rather than deleted because the DIVISION it describes still holds and
/// is the whole reason the queue is a second table: an ASK and its refusal are auditable history
/// and are kept for ever, a GRANT is current fact and is deleted when it ends. Granting a request
/// writes a row HERE, through `services/design_workshop_viewers.replace_viewers`, so there is
/// still exactly one way to be a viewer.
///
/// Removing a viewer therefore DELETES the row rather than revoking it, which is the one place
/// this departs from the sibling table's "nothing is ever deleted". A grant here carries no
/// decision to audit — it never refused anybody and was never asked for — so a tombstone would
/// record only that an admin changed their mind about a colleague.
model DesignWorkshopViewer {
  designWorkshopId String
  userId           String
  /// The admin who granted it. Nullable so the relation below can be SetNull.
  grantedById      String?
  createdAt        DateTime @default(now())

  designWorkshop DesignWorkshop @relation("DesignWorkshopViewers", fields: [designWorkshopId], references: [id], onDelete: Cascade)

  /// CASCADE, and deliberately NOT the `Restrict` that every CREATOR relation on User carries.
  ///
  /// `Restrict` is right for authorship — `DesignWorkshop.createdBy`, `Artisan.createdBy` and the
  /// rest — because deleting the account would erase who recorded the research. A viewer row is
  /// not authorship: it says an account that no longer exists was once allowed to read something,
  /// which is worth nothing to anybody. Restricting would instead add a brand-new reason an
  /// account cannot be deleted (see `_undeletable_detail` in api/routes/users.py, where that is
  /// already the ordinary case) — and a reason no admin could clear, because no screen offers
  /// "take this person off every workshop". It also matches the two access tables that already
  /// exist: `WorkshopAssignment.user` and `DataAccessGrant.grantee` are both Cascade.
  user User @relation("DesignWorkshopViewerUser", fields: [userId], references: [id], onDelete: Cascade)

  /// SetNull, matching `WorkshopAssignment.assignedBy`. The grant must outlive the admin who made
  /// it: losing the granter mid-season must not quietly lock a working co-designer out of the
  /// workshop they are halfway through, and "who let them in" is not worth an outage.
  grantedBy User? @relation("DesignWorkshopViewerGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  /// The pair IS the identity — one grant per person per workshop — so a re-grant collides rather
  /// than stacking a second row, and the PK serves the "may this user open this workshop" lookup
  /// `load_workshop_or_404` makes on every read by a non-creator.
  @@id([designWorkshopId, userId])
  /// The other direction: "which workshops may this user see", which is the LIST endpoint's scope
  /// clause. Not covered by the primary key above — userId is its SECOND column — so without this
  /// the workshop list would sequentially scan the grant table for every non-admin request.
  @@index([userId])
  /// The account pointer, indexed for the onDelete action it is on the wrong end of rather than
  /// for a read. See the long note on `DwStageEntry.createdById` for the decision this follows.
  @@index([grantedById])
}

/// WHAT A REQUEST CAN BE — the three states one can be in, and there is no fourth.
///
/// PENDING is the only state that means anything is owed to anybody; GRANTED and DENIED are both
/// settled. There is deliberately no REVOKED, unlike `WorkshopAssignment.status`: revoking access
/// is taking a name off `DesignWorkshopViewer`, which is the viewers PUT's job and leaves no
/// question here to answer. A request that was granted and later revoked stays GRANTED, because
/// what it records is that the ASK was answered yes — not that the access still stands.
///
/// AN ENUM AND NOT TEXT, on `DwReviewRound`'s reasoning rather than `WorkshopAssignment.status`'s.
/// This column decides WHICH QUEUE a row is in, and a typo'd status is a request that appears in
/// neither the pending list an admin works through nor the settled history they audit — a person
/// waiting for access that nobody can see they asked for, which is the exact failure the whole
/// feature exists to end. Postgres refuses the typo; TEXT would store it.
enum DwAccessRequestStatus {
  PENDING
  GRANTED
  DENIED
}

/// HOW THE REQUESTER CAME BY THE ID THEY ASKED ABOUT, which is the one thing an admin working the
/// queue actually needs and cannot otherwise get.
///
/// The owner's rule is that a designer PARTICIPATES in a workshop somebody else created, and the
/// way they are meant to meet one is by scanning the card the creator prints
/// (`frontend/lib/workshopCodes.ts`). SCAN means the request carried a well-formed `DPW1:G:...`
/// code that decoded to this workshop; MANUAL means it did not, and the id arrived some other way.
///
/// **IT IS EVIDENCE, NOT AUTHORISATION, AND THE DIFFERENCE IS LOAD-BEARING.** The code's four check
/// characters are FNV-1a, the algorithm is in a file shipped to the browser, and that file says so
/// in terms: "it is a typo detector and nothing more ... anyone can compute a valid check for any
/// id". So SCAN does not prove possession of a card and must never be treated as though it did.
/// What it is worth is exactly what was asked for — an admin can see at a glance that a request
/// came from a real code rather than a guessed id — and an admin deciding a MANUAL request knows
/// to ask how the person came by the identifier.
enum DwAccessRequestSource {
  SCAN
  MANUAL
}

/// A designer asking to be let into a design & prototype workshop they are not on.
///
/// -- THE GAP THIS CLOSES ----------------------------------------------------------------------
///
/// Every route that can put somebody on a design workshop is `Depends(require_admin)`, and that is
/// deliberate and is not weakened here: a designer must never be able to create a workshop (two
/// devices holding rival copies of one workshop is how a fortnight of fieldwork gets split in
/// half), and administering the team belongs to somebody who is still here when the creator leaves.
/// The consequence nobody had built for is that a designer standing next to the person who made the
/// workshop, holding the card they were just handed, had NO ENDPOINT through which to ask. The web
/// client knows it today: `unresolvedWorkshopCodeMessage` in `frontend/lib/workshopCodes.ts` returns
/// a sentence telling that designer to send the code to an admin and ask, and the comment above that
/// `return` says why — "AND IT DOES NOT SAY 'REQUEST SENT', because nothing has been sent". A
/// previous wave deliberately shipped no "pending" state on the client rather than tell a designer
/// their request was queued somewhere no admin would ever look. This table is the queue that makes
/// that state honest.
///
/// -- WHY IT IS NOT MORE COLUMNS ON `DesignWorkshopViewer` -------------------------------------
///
/// That is the shape `WorkshopAssignment` took — one row carrying both the ask and the grant — and
/// it is wrong here for a reason that table demonstrates rather than avoids. A viewer row is
/// DELETED when access ends, because it is current fact with no decision in it to audit (see the
/// docstring above, which argues exactly that). A request and its refusal are the opposite: they
/// are history, they are kept for ever, and keeping them is what stops a designer re-asking their
/// way around a no. Merging the two would force one of those rules onto the other — either a
/// removed viewer leaves a tombstone the viewers screen has to learn to hide, or a refusal is
/// erased the next time somebody edits the roster.
///
/// Keeping them apart also keeps the promise that there is ONE way to be a viewer. Nothing reads
/// this table to decide access: `load_workshop_or_404` still asks `has_viewer_grant` and nothing
/// else, and granting a request calls `replace_viewers`, so a GRANTED row here is a receipt for a
/// write that happened over there.
///
/// -- IDEMPOTENCY IS THE UNIQUE BELOW, NOT A SERVICE CHECK -------------------------------------
///
/// One row per (workshop, requester), enforced by Postgres. A request typed in a courtyard reaches
/// this server whenever the handset next finds signal, and a flaky link retries: the SAME ask
/// arriving twice must be one row, and a designer pressing the button again next week must not
/// deposit a second card in an admin's queue. A read-then-write in the service is not that
/// promise — it is two round trips with a window in the middle, which is the shape that has
/// already produced a double-filed government record in this repository.
///
/// A REPLAY IS A NO-OP AND DOES NOT MOVE `createdAt`, which is the opposite of what
/// `POST /workshops/access-requests` does to a re-request, and the difference is deliberate rather
/// than an inconsistency. There, a fresh ask after a REFUSAL is genuinely a new request and the
/// queue should re-rank it. Here the second delivery is the same ask, so restamping it would push
/// the person who asked first down a queue ordered oldest-first — the anti-spam rule inverted into
/// a way to jump the queue.
model DesignWorkshopAccessRequest {
  id String @id @default(cuid())

  designWorkshopId String
  /// WHO IS ASKING. Not nullable, unlike `WorkshopAssignment.requestedById`, because that column
  /// distinguishes an admin's grant from a user's ask on a shared row and this table holds only
  /// asks — a request nobody filed is not a state that exists.
  requestedById    String

  status DwAccessRequestStatus @default(PENDING)
  source DwAccessRequestSource

  /// THE CODE AS IT WAS SCANNED, stored in its canonical `DPW1:G:...:CHCK` form and NULL for a
  /// MANUAL ask. Kept as the string rather than reduced to the `source` beside it so an admin can
  /// compare it against the card in front of them, and so a support conversation about a misprinted
  /// batch has something to look at. It carries no identity data by construction — see
  /// `frontend/lib/workshopCodes.ts`, which refuses at runtime to encode anything that is not
  /// shaped like an id this repository issues, naming Aadhaar and Pehchan numbers specifically.
  scannedCode String?

  /// What the requester wants to say to the admin ("Rekha asked me to join stage 4"). Optional: a
  /// bare ask is legitimate, and demanding a sentence is how people stop asking.
  note String?

  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  designWorkshop DesignWorkshop @relation("DesignWorkshopAccessRequests", fields: [designWorkshopId], references: [id], onDelete: Cascade)

  /// CASCADE on both accounts' own rows, matching `DesignWorkshopViewer` rather than the authorship
  /// relations. A request is not research anybody recorded; it is a person having once asked to be
  /// let in, which is worth nothing once the account is gone — and RESTRICT would invent a new
  /// reason an admin cannot delete an account, with no screen anywhere offering to clear it.
  requestedBy User  @relation("DwAccessRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  /// SetNull, matching `DesignWorkshopViewer.grantedBy`: the decision must outlive the admin who
  /// made it. "Who refused this" is worth having and is not worth an outage.
  decidedBy   User? @relation("DwAccessRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  /// ONE ASK PER PERSON PER WORKSHOP. This is the whole idempotency guarantee — see the header.
  /// THERE IS NO "HAS THIS PERSON ALREADY ASKED" PROBE, AND THERE MUST NOT BE ONE. The request
  /// route inserts with ON CONFLICT DO NOTHING (`create_many(skip_duplicates=True)`) and reads the
  /// returned count, so THIS INDEX is what makes a replayed ask a no-op — a read-then-write in the
  /// service would be the two round trips with a window in the middle that the header refuses. Its
  /// leading column is also what the `designWorkshopId` CASCADE walks.
  @@unique([designWorkshopId, requestedById])
  /// THE QUEUE, COLUMN FOR COLUMN: `where={"status": "PENDING"}` ordered `createdAt` ascending, so
  /// the pending list an admin works through is a range scan of this btree rather than a sort of
  /// every request ever filed. Ordering oldest-first is what stops a queue nobody finishes.
  @@index([status, createdAt])
  /// The account pointers, indexed for the onDelete actions they are on the wrong end of rather
  /// than for a read — the unique above cannot serve `requestedById`, which is its SECOND column.
  /// See the long note on `DwStageEntry.createdById` for the decision this follows.
  @@index([requestedById])
  @@index([decidedById])
}

/// One record of one entity of one stage. A SINGLETON entity has exactly one row per workshop;
/// a COLLECTION entity has as many as the designer created.
///
/// `data` holds the field values, keyed by `FieldSpec.key`. It is validated against the
/// registry on write (`validate_entry`) and read back through it, so an unknown key cannot
/// reach the report — but an unknown key does NOT reject the write, because a phone one release
/// ahead of the server would otherwise lose a whole stage. See app/schemas/design_workshops.py.
model DwStageEntry {
  id               String @id @default(cuid())
  designWorkshopId String
  /// The StageSpec.key, e.g. PROTOTYPE_DEVELOPMENT. Stored rather than derived from entityKey
  /// so a stage's rows can be fetched in one query without consulting the registry.
  stageKey  String
  /// The EntitySpec.key, e.g. `prototype`. Unique across the whole registry by rule.
  entityKey String
  /// Orders a collection's rows. A singleton's is always 0.
  ordinal   Int    @default(0)
  data      Json

  /// WHO LAST SET EACH FIELD OF `data`, sparse: `{fieldKey: {by, byName, at, source, ...}}`.
  ///
  /// `createdById` below answers "who created this ROW" and stops being the truth the moment a
  /// second designer touches it — which is the ordinary case, because `DesignWorkshopViewer`
  /// exists so that two designers run one workshop over one set of rows. This column answers the
  /// question that actually gets asked: who set THIS field.
  ///
  /// TWO SOURCES, AND THE SECOND IS THE REASON THE COLUMN EXISTS. `source: "designer"` is a person
  /// on this workshop typing. `source: "reference"` is a value `hydrate_entries` COPIED from a
  /// shared canonical record — an Artisan, a documented tool — in which case `by` is that RECORD's
  /// author and not the designer who picked it from the dropdown, and `refModel`/`refId`/`refKey`
  /// name the row and column it came from. That is what makes "provenance stays with the original
  /// author unless a field is edited" expressible: 81 field-pairs are copied onto these rows, and
  /// before this column nothing distinguished a value the designer wrote from a value the picker
  /// supplied.
  ///
  /// SPARSE, AND AN ABSENT KEY IS AN HONEST ANSWER. Every row written before this column has
  /// values nobody recorded an author for. Backfilling them to whoever saves next would
  /// manufacture an audit trail on a document submitted to a ministry. See
  /// `app/services/entry_provenance.py`, whose module docstring also carries the boundary between
  /// this and `REFERENCE_HYDRATION` — one says do not duplicate, the other deliberately does, and
  /// both are right for different objects.
  ///
  /// NOT INSIDE `data`. `data` is validated against the registry and echoed back to both clients;
  /// a reserved key in it would be reported in `droppedKeys` on every save, destroying the one
  /// drift signal this repository has.
  fieldProvenance Json?

  /// Set by the client that created the row, and stable across a sync. It is what lets the
  /// phone match a row it created offline to the row the server now has, without which every
  /// reconnect would duplicate the whole collection.
  ///
  /// A SINGLETON ROW AND THE `_custom` CONTAINER DO NOT GET THE CLIENT'S KEY — they get a RESERVED
  /// one, `'__dw_singleton__:' || stageKey`, written by the server. Those rows are supposed to be
  /// unique by (workshop, entity), and the unique index below could not enforce that while their
  /// key was null: Postgres treats NULLs as distinct under a unique index, so uniqueness was a
  /// read-then-write in `save_stage` with seconds between the two halves on a field link. Two
  /// designers on one workshop — which `DesignWorkshopViewer` exists to allow — could each find no
  /// singleton and each insert one, after which which of the two answers gets scored, printed and
  /// shown could differ between two reads of unchanged data. A non-null value hands that to the
  /// index. See `design_workshops.singleton_client_key` for why the stage key is in the value
  /// (`_custom` uses one entity key on every stage) and `20260822094000_dw_singleton_client_key`
  /// for the backfill.
  ///
  /// THERE ARE TWO WRITERS OF SINGLETON ROWS AND BOTH SET IT. `save_stage` is the obvious one;
  /// `seed_designer_prefill` is the one that matters more, because it runs on `POST
  /// /design-workshops` and is what puts `workshopSetup` — the singleton carrying the promoted
  /// columns — into essentially every new workshop. A third writer added without the key would
  /// reopen this hole silently, since the index simply stops applying to the rows it misses. An
  /// EXISTING row that carries no key adopts one on its next ordinary save
  /// (`design_workshops._reserved_key_upgrade`), so the guarantee holds going forward rather than
  /// holding only for the rows the one-off backfill happened to see.
  ///
  /// A COLLECTION ROW IS UNTOUCHED and may still be null — the browser sets no key at all, and
  /// `test_stage_sync.test_many_rows_without_a_client_key_coexist` pins that.
  clientKey String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  deletedAt   DateTime?

  designWorkshop DesignWorkshop @relation(fields: [designWorkshopId], references: [id], onDelete: Cascade)
  createdBy      User?          @relation("DwStageEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// What designers thought of this row, when it is a sketch or a prototype. Empty for the other
  /// forty-one entity kinds, which are not rated by anybody. See DwReviewRating.
  reviewRatings  DwReviewRating[] @relation("DwStageEntryReviewRatings")

  /// The read pattern: every row of one stage of one workshop, in order.
  @@index([designWorkshopId, stageKey, ordinal])
  @@index([designWorkshopId, entityKey])
  /// The CROSS-WORKSHOP read, which the two indexes above cannot serve because both lead with
  /// `designWorkshopId` and a btree cannot be probed on its second column.
  /// `/analytics/design-workshops` asks for a named handful of entity keys across the WHOLE
  /// archive (see `ANALYSED_ENTITIES` in api/routes/analytics.py), so without this it is a
  /// sequential scan whose cost is the size of the archive rather than the size of the answer:
  /// measured warm on 6,952 rows it discarded 6,883 of them to return 69, at 4.30 ms and 312
  /// shared buffers, against 0.30 ms and 62 buffers with the index.
  ///
  /// The four milliseconds are NOT the reason — the endpoint measures the same either way today
  /// (37 ms vs 40 ms). The shape is: this is the one read in the design-workshop family whose
  /// cost grows with the archive instead of with the result, on the one endpoint built to grow.
  /// See the migration for the full before/after.
  @@index([entityKey])
  /// A client key identifies one row within one workshop. Partial on clientKey being non-null is
  /// not expressible here, so the application skips the MATCH when clientKey is null — and, for the
  /// rows that must be unique whether or not a client supplied a key, writes the reserved value
  /// described on `clientKey` above rather than a null. A partial unique index is deliberately NOT
  /// the answer: it would break the browser's null-keyed collection rows and `save_stage`'s
  /// duplicate-key recovery, both of which need many nulls to coexist here.
  @@unique([designWorkshopId, entityKey, clientKey])
  @@index([deletedAt])
  /// The creator, indexed for the WRITE it is on the wrong end of rather than for any read this
  /// table serves. `DwAiLayer`, `DwAiLayerDecision` and `DwWorkshopConsentDecision` each state that
  /// rule beside their own account pointers and follow it; `DwCustomSection`, whose migration copied
  /// this model's shape, gave its copy the index. This model — the largest in the family — was the
  /// exception, and the exception was never argued anywhere.
  ///
  /// THE DECISION, WRITTEN DOWN HERE SO THE NEXT READER DOES NOT RE-DERIVE IT. `createdById` is
  /// `onDelete: SetNull`, so deleting a user makes Postgres look for every stage entry naming them;
  /// unindexed, that is a sequential scan of this table. **This is not a performance emergency and
  /// is not claimed to be one.** At the 6,952 rows measured for `@@index([entityKey])` above the
  /// scan is single-digit milliseconds, and deleting an account is a rare administrative action
  /// nobody is timing. What made the exception worth closing is the INCONSISTENCY: the schema
  /// states this rule in three places and applies it in four, and the one model it skipped is the
  /// one whose own reasoning bites hardest — a reader comparing the models could only conclude
  /// there was an unwritten exemption and go hunting for what it was.
  ///
  /// WHAT IT COSTS, honestly: one btree insert per stage-entry insert, on a table that already
  /// carries five indexes and is written on every stage save. That is the whole price, and it buys
  /// consistency rather than speed.
  ///
  /// Eleven sibling columns elsewhere in this schema were in the identical state — a User pointer
  /// with an onDelete action and no index — and were given the same treatment in the same change.
  /// See `20260822093000_index_the_account_pointers`, which names all twelve.
  @@index([createdById])
}

/// A block of questions a DESIGNER added to ONE design workshop, with no deployment.
///
/// The 22 stages are Python literals in `services/stage_definitions.py`, and that file is a
/// deployment. This table is how a designer standing in a cluster records one more thing without
/// one — and everything about its shape is about making that safe rather than possible.
///
/// WORKSHOP-SCOPED, and that is a decision rather than a default (plan §6, answer 2). A bad
/// definition damages one record instead of every record sharing a template; completeness scoring
/// has one unambiguous owner; and editing a definition cannot retroactively change a workshop that
/// has already been submitted. It also means no new permission concept exists —
/// `DesignWorkshopViewer` already answers "who may open this workshop".
///
/// THE ANSWERS ARE NOT HERE. They live in one `DwStageEntry` row per (workshop, stage) whose
/// `entityKey` is the reserved literal "_custom" and whose `data` is keyed by `DwCustomField.key`.
/// That row is invisible to the registry, to `promoted_values` and to the collection sweep, which
/// is exactly what makes a client that has never heard of this feature unable to destroy anything
/// in it: `save_stage`'s default is a wholesale replace, so a nested container would have been
/// deleted in silence by every client one release behind. See app/services/custom_sections.py.
model DwCustomSection {
  id               String @id @default(cuid())
  designWorkshopId String

  /// The `StageSpec.key` these questions are asked at, validated against `stages()` at definition
  /// time. REQUIRED, and not the plan's nullable "belongs nowhere": the answers live in the
  /// `_custom` row of this stage, so a section with no stage would have nowhere to put them. Where
  /// the section PRINTS is a separate question — a template that does not carry this stage prints
  /// the section as its own annexure (`apply_report_settings`).
  stageKey String
  /// Stable, unique within the workshop, and never renamed — it is what a definition edit matches
  /// against, so renaming one makes the whole section read as new and retires the old one.
  key         String
  title       String
  description String @default("")
  /// Where in the running order this section prints among this workshop's own sections.
  sortOrder   Int    @default(0)

  /// Counts the edits that could not be applied in place — every supersede and every retire under
  /// this section. Exactly what `Questionnaire.version` counts and for its reason: it ORDERS edits
  /// for an audit and for two reports of one workshop that disagree. It is NOT the staleness
  /// signal; that is the content digest `customSchemaVersion`, because a revision that only ever
  /// increases on a destructive edit says nothing about the ordinary ones.
  revision Int @default(1)

  /// Retired rather than deleted once anything under it has been answered — the rule
  /// `services/questionnaire_forms.py` states in full, for its reason.
  isActive  Boolean   @default(true)
  retiredAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  designWorkshop DesignWorkshop  @relation("DesignWorkshopCustomSections", fields: [designWorkshopId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation("DwCustomSectionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  fields         DwCustomField[]

  /// Scoped uniqueness, exactly as `QuestionnaireFormSection.@@unique([questionnaireId, code])`:
  /// two designers both naming a section "extra" is normal and must not collide.
  @@unique([designWorkshopId, key])
  @@index([designWorkshopId, sortOrder])
  @@index([createdById])
}

/// One designer-defined field. Once it has an answer it is effectively IMMUTABLE — see
/// `supersededById`.
model DwCustomField {
  id        String @id @default(cuid())
  sectionId String

  /// WHAT THE ANSWER IS STORED UNDER, inside the "_custom" row's `data`. Permanent: renaming one
  /// orphans the answer, exactly as `stage_schema`'s rule 1 says of a `FieldSpec.key`. Unique
  /// within the section here, and unique within the WHOLE WORKSHOP in the service — because one
  /// stage's answers all share one flat container, so two fields on one stage sharing a key would
  /// share one answer.
  key   String
  label String
  help  String @default("")
  /// One of the twelve `FieldType` tokens v1 allows. A String and not a Postgres enum, because the
  /// vocabulary belongs to the registry and the registry is Python that deploys with the server —
  /// unlike `DwAiLayerKind`, which is seven values fixed by a plan. A token this build does not
  /// know is refused at definition time and read back as TEXT rather than raising.
  type String
  /// BASIC | STANDARD | ADVANCED. Only BASIC may be required — `validate_registry` rule 3, for its
  /// reason: a workshop held in a village without power must still be able to complete.
  tier       String  @default("STANDARD")
  isRequired Boolean @default(false)
  /// ENUM/MULTI_ENUM options as an ordered [{value,label}] array. Inline rather than an entry in
  /// the shared `ENUMS` table: a designer's list is theirs, and a shared table is what makes
  /// "cotton" the same answer in stage 5 and stage 17 — a promise a per-workshop list cannot keep.
  options   Json?
  unit      String  @default("")
  maxLength Int?
  minValue  Float?
  maxValue  Float?
  sortOrder Int     @default(0)

  isActive  Boolean   @default(true)
  /// When it stopped being asked. Set together with isActive=false so "retired" is distinguishable
  /// from a field the designer unticked before anybody answered it.
  retiredAt DateTime?
  /// THE FIELD THAT REPLACED THIS ONE when its LABEL was rewritten after it had answers. A
  /// deliberately PLAIN COLUMN and not a relation, exactly as `QuestionnaireFormQuestion.supersededById`
  /// is: it is only ever read to follow "replaced by", never joined through.
  ///
  /// The recorded answers stay under THIS row's key with the label they were given under, and the
  /// new wording becomes a new row under a newly minted key. The failure this prevents is the one
  /// that module names: "How many looms?" answered "12", reworded to "How many weavers?", and a
  /// ministry report now states there are twelve weavers.
  supersededById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section DwCustomSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, key])
  @@index([sectionId, sortOrder])
  @@index([supersededById])
}

/// Every report file ever produced for a workshop, whether by the server or on a phone with no
/// network. The bytes are not stored here — only the fact, so a file handed to an office can be
/// matched back to the record and the template it came from.
model DwReportExport {
  id               String  @id @default(cuid())
  designWorkshopId String
  format           String
  templateId       String
  fileName         String
  fileSizeBytes    Int?
  pageCount        Int?
  checksumSha256   String?
  /// True when the phone produced the file offline. The distinction matters for the archive:
  /// an on-device export exists on exactly one device until someone copies it off.
  generatedOnDevice Boolean @default(false)
  /// The registry digest and template in force at generation, so a report can be reproduced.
  schemaVersion String?
  warnings      String?
  storageKey    String?

  generatedAt   DateTime @default(now())
  generatedById String?

  designWorkshop DesignWorkshop @relation(fields: [designWorkshopId], references: [id], onDelete: Cascade)
  generatedBy    User?          @relation("DwReportExportGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)

  @@index([designWorkshopId, generatedAt])
  @@index([generatedById])
}

// ======================================================================================
// AI layers: what a model produced, what it was produced FROM, and who accepted it
//
// THE LAW THESE THREE DECLARATIONS ENFORCE is written out in full in
// `app/services/ai_layers.py` and in docs/PLAN-AI-TIERS-AND-CUSTOM-SECTIONS.md §3. In one
// sentence: a model's output is a NEW ROW carrying the provenance of the run that made it, inert
// until a person accepts it, and it never touches the thing it was made from.
//
// IT IS THE SAME LAW `REFERENCE_HYDRATION` ALREADY OBEYS, one step further out. Hydration copies a
// referenced record's display fields onto the stage entry at SAVE time and the report never
// re-resolves them, because a record edited in 2027 must not silently change a document handed to a
// ministry officer in 2026. An AI layer is the same problem with a worse failure mode: re-running a
// summariser six months later does not merely change a name, it replaces an artisan's account of
// their own work with a different paraphrase, and nothing on the page would say it had happened.
//
// WHY A SEPARATE TABLE RATHER THAN COLUMNS ON `DwStageEntry` OR ON `MediaFile`. Because a column is
// an edit. `MediaFile.transcriptText` is a single column, and `media_queue._transcript_write` has
// already had to grow a long comment explaining that a FAILED re-run must not write its empty
// result over a good transcript — that comment exists because a column has room for exactly one
// answer and the second run destroys the first. The plan requires the opposite: Tier 1 on a phone
// and Tier 3 in the cloud produce different text from the same audio, legitimately and for ever,
// and BOTH have to survive so a reviewer can see which one a report printed.
// ======================================================================================

/// Which rung of which chain a layer occupies. Closed, and closed on purpose.
///
/// The vocabulary is exactly the plan's two chains plus the two extractive verbs it says to start
/// with, and nothing else:
///
///     audio ──▶ RAW_TRANSCRIPT ──▶ CLEANED_TRANSCRIPT ──▶ SUMMARY
///     photo ──▶ OCR_TEXT       ──▶ STRUCTURED_TEXT
///     (either) ──▶ TAGS, METADATA
///
/// TAGS and METADATA are here and the generative verbs are deferred because of the plan's
/// "Recommended first Tier 2 verb: none of the generative ones" (§2.1): a wrong tag is a suggestion
/// the designer declines, whereas a wrong summary is model prose standing where an artisan's words
/// were. Declaring the generative kinds now anyway is deliberate — the kind is what the report
/// annexure prints as the layer's NAME ("AI-cleaned transcript"), so the vocabulary has to exist
/// before the writing does or step 3 has nothing to name.
///
/// A DATABASE ENUM RATHER THAN A STRING COLUMN, unlike `DwStageEntry.stageKey`, which is free text
/// because the 22 stages are Python literals that deploy with the server. This vocabulary is not
/// like that: it is a closed set fixed by a plan, and a typo'd kind on a row would print as an
/// unknown annexure heading in a submitted document. Postgres refuses the typo; a String column
/// would store it. The cost is that a new verb needs a migration, which is the correct price for
/// adding a way for a model to write into a government record.
///
/// THE SECOND FIVE ARRIVED WITH THE VERBS (migration 20260812150000) and each is a distinct promise
/// to a reader rather than a synonym for one already here:
///
/// * `PROOFREAD` corrects spelling, grammar and punctuation and changes NOTHING else. It is not
///   `CLEANED_TRANSCRIPT`, which restructures a conversation into speaker turns and, on a default
///   deployment, translates it — two headings for two promises, because one heading for both would
///   let a rewrite be printed under the word "proofread".
/// * `EXPANDED` writes a terse field note out into prose. THE ONLY KIND THAT INVENTS SENTENCES
///   rather than transforming ones somebody said, and therefore the one the annexure warns about by
///   name.
/// * `TRANSLATION` is always a SIBLING and never a replacement — see `sourceLanguage` below.
/// * `CAPTION` describes a photograph or a video in one sentence, for the media annexure and for a
///   screen reader.
/// * `SUBTITLES` is timed text, and is the only kind whose principal content is `payload` rather
///   than `text`: a subtitle without its timings is a transcript, and the timings are the verb.
enum DwAiLayerKind {
  RAW_TRANSCRIPT
  CLEANED_TRANSCRIPT
  SUMMARY
  OCR_TEXT
  STRUCTURED_TEXT
  TAGS
  METADATA
  PROOFREAD
  EXPANDED
  TRANSLATION
  CAPTION
  SUBTITLES
}

/// WHICH MACHINE PRODUCED IT: 1 on the handset, 2 a small model on the handset, 3 the cloud.
///
/// This column is the safeguard that makes device-dependent tiering safe at all (plan §2.1, "The
/// device decides the tier and the model"). A 4 GB Galaxy M32 and a 12 GB flagship will not run the
/// same tier, so the fleet WILL produce two classes of workshop record; without this column they
/// are indistinguishable on the page and a reviewer cannot tell a cloud-diarized interview from a
/// device-guessed one. The plan states the pairing as a condition: device-based tiering and
/// provenance ship together or not at all.
///
/// SPELLED `TIER_1` RATHER THAN STORED AS AN `Int`, for two reasons. Postgres can then refuse a 4
/// or a 0 itself, and a CHECK constraint — which is the only way an Int column could refuse them —
/// is invisible to schema.prisma and would have to be maintained by hand for ever. And it is not
/// arithmetic: nothing computes with a tier, nothing compares 1 < 3 to decide anything, so an
/// integer column would invite exactly the "higher tier is better" ordering the plan denies (Tier 1
/// runs with no signal, which is the only tier that works in the courtyard).
///
/// NOT TO BE CONFUSED WITH `stage_schema.Tier` (BASIC / STANDARD / ADVANCED), which says how
/// important a FIELD is to a complete record and has nothing to do with which machine ran a model.
/// The two words collide in this repository and the Python side keeps them apart by naming this one
/// `AiTier`; see the note at the head of app/services/ai_layers.py.
enum DwAiTier {
  TIER_1
  TIER_2
  TIER_3
}

/// The two things a person can do to a layer, recorded as an event rather than as a state.
enum DwAiDecision {
  ACCEPTED
  WITHDRAWN
}

/// One thing a model produced, and everything needed to know what produced it.
///
/// RULE 1 — EVERY LAYER IS A ROW, NEVER AN EDIT. Nothing in this table is updated with new model
/// output. A cleaned transcript is a row whose `sourceLayerId` names the raw transcript it was
/// cleaned from; the raw row is untouched and stays readable beside it for ever.
///
/// RULE 2 — EVERY LAYER CARRIES ITS PROVENANCE. `tier`, `provider`, `modelId`, `modelVersion`,
/// `language`, `producedAt`/`createdAt`, and the source it was derived from. The plan's reason is
/// worth restating because it is not obvious on the day the row is written: without the model id, a
/// systematic error found in six months — a provider silently changing a checkpoint, a
/// quantization that mangles Odia numerals — cannot be traced to the material it damaged, and the
/// only remedy left is to distrust every transcript in the archive.
///
/// RULE 3 — A LAYER IS INERT UNTIL A PERSON ACCEPTS IT. `acceptedAt`/`acceptedById` are null on
/// every new row and no code path sets them except a human pressing accept. Reports print the
/// accepted layer (rule 4, step 3 of the plan's sequence); an unaccepted one is a suggestion sitting
/// in a table.
///
/// RULE 5 — DELETING A DERIVED LAYER NEVER TOUCHES ITS SOURCE. Deletion here is `deletedAt`, the
/// same soft delete `DesignWorkshop` and `DwStageEntry` use for the same stated reason: a
/// designer's two weeks of fieldwork is not something a mis-tap should end. A layer's source is
/// reached through `sourceMediaId`/`sourceLayerId` and neither is ever written by a delete.
model DwAiLayer {
  id               String @id @default(cuid())
  /// The workshop this layer belongs to, denormalised rather than walked to through the source.
  /// Without it the annexure loader would have to resolve every layer's chain down to a media file
  /// and then that media file back to a stage entry before it could ask "which of these are mine",
  /// which is the shape of read this repository has already had to index its way out of once
  /// (see the `DwStageEntry_entityKey_idx` migration).
  designWorkshopId String

  kind DwAiLayerKind
  tier DwAiTier

  /// THE SOURCE IS A DISCRIMINATED TRIPLE, NOT THREE OPTIONAL COLUMNS. Exactly one of these is set:
  /// `sourceMediaId` for the raw rung of a chain (the transcript of a recording, the OCR or caption
  /// of a photograph, the subtitles of a video), `sourceLayerId` for every rung derived from another
  /// layer, and `sourceText` for a verb run over words the caller supplied. Zero set would be a
  /// layer derived from nothing — model prose with no evidence behind it, which is the one thing
  /// this table exists to make impossible. Two set would be a row claiming two different origins,
  /// and the annexure would have to pick one to print.
  ///
  /// ENFORCED IN THE DATABASE by `DwAiLayer_source_is_exactly_one` (a CHECK on
  /// `num_nonnulls(...) = 1`, written in the migration because Prisma has no syntax for it) AND in
  /// `ai_layers.layer_create_plan`, which refuses the same shapes with a sentence naming what
  /// to send instead. Two guards for one rule because the constraint gives a 500 with a Postgres
  /// message and the service gives a 422 a client can act on; the constraint is what makes the rule
  /// true for rows this API never sees, such as a backfill run by hand.
  sourceMediaId String?
  sourceLayerId String?
  /// THE WORDS A VERB WAS GIVEN, WHEN THEY CAME FROM THE CALLER RATHER THAN FROM A ROW.
  ///
  /// A `PROOFREAD` or an `EXPANDED` of a designer's field note has nothing to point at: the note is
  /// being typed into a form that has not been saved, which is the whole moment the verb exists for,
  /// and even once it is saved there is deliberately nowhere on this table to say WHICH field it came
  /// from — `test_the_layer_table_cannot_name_a_place_in_stage_data` forbids `fieldKey`, `entityKey`,
  /// `stageKey`, `entryId` and `ordinal` precisely so that no later feature can answer "which box
  /// does this belong in" by writing model prose into that box.
  ///
  /// So the evidence travels as a COPY, exactly as a layer holds a copy of a transcript instead of
  /// pointing at `MediaFile.transcriptText`, and for REFERENCE_HYDRATION's reason: a field edited
  /// next March must not silently change what an annexure printed last year under somebody's name.
  ///
  /// IT IS THE VERB'S INPUT AND NEVER ITS OUTPUT, which is the whole difference from the `text`
  /// field `AiLayerRegisterIn` refuses in the strongest terms. A client chooses what to have
  /// proofread; it cannot choose what the proofreading says, because `text` below is written from
  /// the answer a provider gave to a call THIS server made, with the provider and model id this
  /// server observed.
  ///
  /// READABLE BY ANYONE WHO MAY OPEN THE WORKSHOP, and that limit is stated rather than hidden: this
  /// is workshop content, not a recording, so the per-file media gate does not reach it. A designer
  /// who pastes an artisan's transcript in here has widened who can read those words.
  sourceText    String?

  /// WHO RAN IT AND WHAT THEY RAN. Both NOT NULL and both allowed to hold the exact string
  /// `UNRECORDED`, which is the honest-unknown discipline this repository already applies to
  /// language packs (`DwPackState`): a fact nobody recorded is stated as unrecorded, never guessed
  /// and never left as a null that reads like "none".
  ///
  /// THE UNKNOWN IS NOT HYPOTHETICAL — IT IS THE COMMON CASE ON DAY ONE. Every transcript this
  /// system has ever produced was written by `media_queue._transcript_write`, which stores
  /// `transcriptText`, `transcriptSummary`, `transcriptStatus` and `transcriptError` and NOT which
  /// of the four providers in the chain produced them. `services/ai.py` knows — it picks between
  /// OpenAI, ElevenLabs Scribe v2, Deepgram Nova-3 and Gemini at call time, and Deepgram is called
  /// with `language=multi` — but nothing persists the answer. So a Tier 3 raw transcript registered
  /// from an existing `MediaFile` truthfully carries `provider = "UNRECORDED"`, and the annexure
  /// can say so instead of asserting a model that may not have produced it.
  provider     String
  modelId      String
  /// The checkpoint or dated version, when the provider publishes one distinct from `modelId`.
  /// NULL means the writer recorded none. It deliberately does NOT distinguish "this model has no
  /// version" from "nobody wrote it down" — that distinction is itself unrecorded, and inventing a
  /// column to hold a guess at it would be worse than the ambiguity.
  modelVersion String?
  /// The language of THIS layer's content, as the run understood it. NULL means unrecorded.
  ///
  /// `multi` is a legitimate value, not a placeholder: Deepgram Nova-3 is deliberately called with
  /// `language=multi` because a workshop is Hindi code-switched with English mid-sentence, so for
  /// most of the archive "the language" genuinely is "several, interleaved". A column that only
  /// admitted one BCP-47 tag would force a lie on the majority of rows.
  language     String?
  /// THE TWO HALVES OF A TRANSLATION, and null on every other kind.
  ///
  /// A translation is the one verb whose provenance is not answerable by one language: "in English"
  /// says nothing about whether the artisan spoke Odia, Hindi or both, and that is exactly what a
  /// reader checking a translated passage needs. So the pair is recorded as COLUMNS rather than
  /// inside `payload` — the provenance line prints "translated from Odia into English", and a fact
  /// that has to be dug out of a JSON blob is one the report will eventually stop printing.
  ///
  /// `language` above keeps its meaning and is written too, holding the same value as
  /// `targetLanguage`, so a reader or a query that knows only about `language` is not silently wrong
  /// about a translation.
  ///
  /// NULL MEANS NOBODY RECORDED IT — never "English". A provider that auto-detects may report
  /// nothing (ElevenLabs Scribe is deliberately not told a language, because these interviews
  /// code-switch mid-sentence), and `multi` is legitimate here for Deepgram's reason.
  sourceLanguage String?
  targetLanguage String?
  /// When the MODEL produced this content, which is not when this row was written.
  ///
  /// NULL rather than defaulting to now(), and the difference is the whole point: a transcript
  /// produced by the queue last March and registered as a layer today would carry a `producedAt` of
  /// today, which is a fabricated fact of exactly the kind rule 2 exists to prevent. `createdAt`
  /// below always says when the row appeared and is never null; this says when the work happened,
  /// when somebody actually knows.
  producedAt   DateTime?

  /// The content, as prose. Uncapped on purpose — an hour-long interview is a large transcript and
  /// refusing to record one would lose the material rather than the layer.
  text    String?
  /// The content, as structure: TAGS is a list, METADATA is an object.
  ///
  /// WHICH SLOT IS THE PRINCIPAL ONE IS DECIDED BY KIND, IN `ai_layers._check_content`: prose kinds
  /// must fill `text`, structured kinds must fill this. The OTHER slot stays optional in both
  /// directions rather than being forbidden, and that is not slackness — a Tier 3 transcript
  /// legitimately has structure beside its prose (Scribe v2 diarizes up to 32 speakers, and those
  /// turns belong with the text they came from rather than in a second row somebody has to keep in
  /// step with it), and a structured layer may carry a human-readable rendering.
  ///
  /// The migration's second CHECK refuses only the row that carries NEITHER, because a layer with no
  /// content at all is a provenance record for nothing: it would take a heading and an index line in
  /// the annexure and print nothing underneath.
  payload Json?

  /// RULE 3, DENORMALISED FOR THE READ PATH. The authoritative history of acceptance is
  /// `DwAiLayerDecision` below; these two columns are the current state, kept here so the report
  /// builder can select the accepted layer without walking a log per layer per render.
  ///
  /// Null on every insert, always. There is no default and no code path that sets them at creation.
  acceptedAt   DateTime?
  /// SetNull, unlike the decision log's `actorId`, which is Restrict. The log is the record of the
  /// act and must outlive the account; this is a cache of it, so it is emptied rather than allowed
  /// to hold a delete up.
  ///
  /// IT IS NOT WHAT LETS THE ACCOUNT GO, AND SAYING SO WOULD BE FALSE: every acceptance writes a
  /// `DwAiLayerDecision` row in the same breath, and THAT row's `actorId` is Restrict — so anybody
  /// who has ever accepted a layer is undeletable for as long as the log stands, which is for ever.
  /// The admin is told so as a sentence rather than as a 500 (`_undeletable_detail` in
  /// api/routes/users.py degrades honestly for relations it cannot name, and this is one of them).
  /// What SetNull buys is narrower and still worth having: if such an account is ever removed by
  /// hand, the layer keeps `acceptedAt` with an empty name — "accepted by somebody no longer on
  /// record" — instead of the delete failing halfway or the acceptance disappearing.
  acceptedById String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  /// Soft delete, exactly as `DesignWorkshop.deletedAt` and `DwStageEntry.deletedAt`. Every read
  /// filters `deletedAt: null`. A deleted layer is a suggestion the designer declined, and keeping
  /// the row is what lets "this was declined on the 3rd" be answerable at all.
  deletedAt   DateTime?
  deletedById String?

  designWorkshop DesignWorkshop @relation("DesignWorkshopAiLayers", fields: [designWorkshopId], references: [id], onDelete: Cascade)

  /// CASCADE, and chosen for a narrow reason rather than a principled one. Restrict would be the
  /// principled choice — a transcript is evidence and should not vanish with its audio — but it
  /// would also give this table a VETO over deleting a `MediaFile`, which the media routes permit
  /// today. Adding a new refusal to somebody else's endpoint is not this step's to make. Recorded
  /// as a decision so the next reader knows it was considered, not overlooked.
  sourceMedia MediaFile? @relation("MediaFileAiLayers", fields: [sourceMediaId], references: [id], onDelete: Cascade)

  /// CASCADE, AND IT HAS TO MATCH `sourceMedia` ABOVE OR AN ORDINARY MEDIA DELETE BECOMES A 500.
  ///
  /// Restrict reads like the principled choice here — a hard delete of a layer something was
  /// derived FROM would destroy the derived row, which is rule 5 read backwards — and it was
  /// written that way first, on the reasoning that nothing in this codebase hard-deletes a layer so
  /// the constraint could only ever fire against a hand-written statement. That reasoning missed
  /// the cascade one line above. `DELETE /api/media/{id}` is a HARD delete (`db.mediafile.delete`,
  /// api/routes/media.py:740), and on a default REFINED_TRANSLATED deployment registering one
  /// recording writes TWO rows: a raw rung pointing at the media file and a cleaned rung pointing
  /// at the raw rung. Deleting that recording cascades into the raw rung, whose deletion the
  /// cleaned rung's Restrict then refuses — inside Postgres, where `delete_media` has no handler
  /// for a ForeignKeyViolationError, so it reaches the admin as "Something went wrong on the
  /// server. The error has been logged." (app/main.py:295). That is the exact defect the user-delete
  /// route already had to grow an except clause for (api/routes/users.py:283), and this table is not
  /// entitled to plant it in another lane's endpoint.
  ///
  /// So the whole chain goes when its audio goes, which is the consequence the media cascade above
  /// already accepted for the raw rung — including the acceptance log, since `DwAiLayerDecision`
  /// cascades from the layer. Deleting a recording therefore destroys the record that a person
  /// accepted a transcript of it. That is a real loss and it is stated here rather than discovered:
  /// making it a refusal instead means giving the media routes a veto, which is the change this
  /// step deliberately does not make.
  sourceLayer DwAiLayer?  @relation("DwAiLayerDerivedFrom", fields: [sourceLayerId], references: [id], onDelete: Cascade)
  derived     DwAiLayer[] @relation("DwAiLayerDerivedFrom")

  acceptedBy User? @relation("DwAiLayerAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  createdBy  User? @relation("DwAiLayerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deletedBy  User? @relation("DwAiLayerDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  decisions DwAiLayerDecision[]

  /// Every read of this table starts with one workshop, so every one of them starts with this
  /// index: the list screen (whole workshop, newest first — it narrows by kind in Python because
  /// the chain walk needs every rung loaded) and the report's `accepted_layers`, which is the read
  /// that does ask SQL for one kind.
  @@index([designWorkshopId, kind, createdAt])
  /// "What has already been derived from this recording", which is how a second registration of the
  /// same transcript is caught before it puts the same text in an annexure twice.
  @@index([sourceMediaId])
  /// The chain walk: given a layer, the rungs above it. It is also what keeps the cascade above
  /// cheap: deleting a recording has to find the rungs standing on the rung it is deleting.
  @@index([sourceLayerId])
  /// The three account pointers, indexed for the WRITE they are on the wrong end of rather than for
  /// any read this step performs: all three are `onDelete: SetNull`, so deleting a user makes
  /// Postgres find every layer naming them, and without these that is three sequential scans of the
  /// layer table inside a request an admin is waiting on.
  @@index([acceptedById])
  @@index([createdById])
  @@index([deletedById])
}

/// Every acceptance and withdrawal of a layer, kept for ever.
///
/// WHY A LOG AND NOT JUST THE TWO COLUMNS ABOVE. Because withdrawal would erase the acceptance that
/// a report has already printed. A designer accepts a cleaned transcript on the 3rd, a .docx goes
/// to the directorate on the 4th naming it as accepted, and on the 11th somebody withdraws it —
/// with columns alone, `acceptedById` goes back to null and the document in the officer's hand
/// becomes unexplainable: it names an acceptance the database now denies ever happened. This table
/// is what keeps "who stood behind this text, and when" RECORDED after the fact.
///
/// RECORDED, NOT YET SERVED. Nothing reads this table back over HTTP except the response to the
/// accept and unaccept calls themselves, so today the question is answerable to somebody with a
/// database and not to somebody with the screen. Step 3 of the plan — the annexure that prints an
/// accepted layer and names it as one — is its first real reader, through
/// `ai_layers.layer_decisions`. A read endpoint for the history is a deliberate omission of this
/// step and not an oversight.
///
/// MODELLED ON `ReviewLog`, which does the same job for record review: an append-only row per
/// decision carrying the actor and the moment, alongside a current-state column on the record
/// itself. The vocabulary is borrowed deliberately so a reader who knows one knows the other.
model DwAiLayerDecision {
  id       String       @id @default(cuid())
  layerId  String
  decision DwAiDecision
  /// Why. Optional, because "I read it and it is right" needs no note, but a WITHDRAWAL usually has
  /// a reason worth keeping ("the model invented a village name").
  note     String?
  actorId  String
  createdAt DateTime @default(now())

  layer DwAiLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)

  /// RESTRICT, exactly as `ReviewLog.reviewer` is, and for the same reason: this row says a named
  /// person took responsibility for putting model output into a government document. An account
  /// that can be deleted out from under that leaves the record saying a decision was made by
  /// nobody. Deleting such an account already fails on a dozen other relations and the message the
  /// admin is shown degrades honestly for relations it cannot name (`_undeletable_detail`).
  actor User @relation("DwAiLayerDecisionActor", fields: [actorId], references: [id], onDelete: Restrict)

  /// The history of one layer, in order.
  @@index([layerId, createdAt])
  /// The actor, indexed for the Restrict above rather than for a read: deleting a user makes
  /// Postgres look for a decision row naming them, on every account deletion.
  @@index([actorId])
}

// ======================================================================================
// Tier 3 consent, and the per-designer daily ceiling on what it permits
// ======================================================================================

/// Every answer a workshop has ever given to "may its recordings leave the device", kept for ever.
///
/// WHY A LOG AND NOT JUST THE THREE COLUMNS ON `DesignWorkshop`. Because consent can be WITHDRAWN,
/// and a withdrawal would erase the answer that a send was made under. An artisan agrees on the 3rd,
/// nine dictations go to Deepgram over the following week, the artisan changes their mind on the 9th
/// and a designer records REFUSED — with columns alone the database now says this workshop never
/// permitted anything, and there is nothing left that explains the nine transcripts sitting in it.
/// "Granted on the 3rd, withdrawn on the 9th" is only answerable from a log. That is exactly the
/// argument `DwAiLayerDecision` above already carries, and the cache-versus-log split is copied from
/// it deliberately so that a reader who knows one knows the other.
///
/// RECORDED, NOT YET SERVED. Nothing reads this table back over HTTP except the response to the
/// consent call itself. A read endpoint for the history is a deliberate omission — the same omission
/// `DwAiLayerDecision` records — and not an oversight.
model DwWorkshopConsentDecision {
  id               String             @id @default(cuid())
  designWorkshopId String
  decision         DwDictationConsent
  /// Why, or under what circumstances. Optional: "the artisan agreed" needs no note, but a REFUSAL
  /// often has a reason worth keeping ("she asked that the audio stay on the phone").
  note             String?
  actorId          String

  /// WHAT THE DEVICE SAID, as distinct from when this server heard it.
  ///
  /// A consent recorded in a courtyard reaches the server on the next sync, which can be a fortnight
  /// later. `createdAt` below is the SERVER's clock and always says when the row appeared; this is
  /// the moment the artisan actually answered, as the device that was there reported it. Null when
  /// the answer was recorded straight against the server, in which case `createdAt` is the same
  /// moment and repeating it here would add nothing.
  ///
  /// It is a separate column rather than a correction to `createdAt` for `DwAiLayer.producedAt`'s
  /// reason, stated there in full: two different questions, and collapsing them means one of the two
  /// answers is fabricated. Here the fabrication would be a consent dated to the sync — a signature
  /// dated to the day it was filed.
  recordedAt DateTime?
  createdAt  DateTime  @default(now())

  designWorkshop DesignWorkshop @relation("DesignWorkshopDictationConsents", fields: [designWorkshopId], references: [id], onDelete: Cascade)

  /// RESTRICT, exactly as `DwAiLayerDecision.actor` and `ReviewLog.reviewer` are, and for a sharper
  /// version of their reason: this row says A NAMED PERSON TOOK RESPONSIBILITY FOR AN ARTISAN'S VOICE
  /// LEAVING THE DEVICE for a third party. An account deleted out from under it would leave the
  /// record saying somebody's recordings were cleared for export by nobody. Deleting such an account
  /// already fails on a dozen other relations and the message the admin is shown degrades honestly
  /// for relations it cannot name (`_undeletable_detail` in api/routes/users.py).
  actor User @relation("DwWorkshopConsentDecisionActor", fields: [actorId], references: [id], onDelete: Restrict)

  /// The history of one workshop's consent, in order — the only read this table has.
  @@index([designWorkshopId, createdAt])
  /// The actor, indexed for the Restrict above rather than for a read: deleting a user makes Postgres
  /// look for a decision row naming them, on every account deletion.
  @@index([actorId])
}

/// One designer's server-dictation spend on one India-time calendar day. Plan §6.1's cap, counted.
///
/// **AUTHORITATIVE HERE AND NOWHERE ELSE.** A client-side counter is a client-side counter: process
/// memory clears on a swipe-away, and a spend ceiling defeated by a swipe-away is the one direction
/// that costs money rather than a retry. The handset keeps a copy so the dictation control can fall
/// back to the phone's own recogniser BEFORE recording — not so it can enforce anything.
///
/// WHY A TABLE AND NOT A COUNTER IN MEMORY OR IN REDIS. One uvicorn worker per pod is deliberate, but
/// prod runs two replicas, so an in-process counter would give every designer TWICE the cap in
/// production and once in staging — a cap wrong by the replica count is worse than no cap, because
/// the number on the settings screen would be a lie. Redis is not there to fall back on either:
/// `scale_cache_backend` defaults to "memory" and the compose Redis is profile-gated, so a Redis
/// INCR+EXPIRE day key would silently do nothing on a default deployment. Postgres is the only
/// always-present store. Redis may later sit IN FRONT of this table; it may never replace it.
///
/// AND NOT `app/scale/rate_limit.py`, which looks like the obvious home and is disqualified four
/// times over: it is flag-gated OFF by default, it keys on a digest of the BEARER TOKEN or the client
/// IP and never on a user id (so one designer's phone and laptop are two buckets), it is in-process
/// unless Redis is configured, and its own docstring calls it "a courtesy backstop … NOT a security
/// control". A spend ceiling that is off in production is not a ceiling.
///
/// ONE ROW PER (designer, day) RATHER THAN ONE PER DICTATION. A per-dictation event table is a row
/// per sentence across the registry's 510 fields per workshop per designer, to answer a question nobody has asked
/// yet ("what did we spend last month") — and that question is still answerable from these rows by
/// summing them. This shape is idempotent, is served entirely by its own primary key, and needs no
/// reset job at all: the key IS the day, so a new day is a new row and the old ones are ordinary
/// history (about one row per designer per working day).
model DwDictationDailyUsage {
  userId String
  /// The SERVER's India-time calendar date as "YYYY-MM-DD". A STRING and not a `DateTime`, because
  /// what is stored is a calendar day and not an instant: a `DateTime` would have to pick a time of
  /// day to represent midnight IST and every reader would have to remember which one.
  ///
  /// **IST, AND THE BOUNDARY IS THE POINT.** "Daily" means nothing without a stated boundary, and a
  /// UTC day would reset a designer's allowance at 05:30 IST — mid-morning to the fleet, which is
  /// what `api/routes/public.py` calls "visibly wrong to the people it is for" about the same choice
  /// for the census. The handset's own timezone is deliberately NOT consulted: two phones with
  /// different clocks would then hold two different allowances against one server row. Computed with
  /// a fixed +05:30 offset by `dictation_cap.ist_day`; see there for why not `ZoneInfo`.
  istDay String
  /// Uploads that actually reached a transcription provider on that day. Incremented after the
  /// provider call, and NOT for a clip refused for size or for a 503 that means no provider is
  /// configured — see `dictation_cap.spend` for the full rule and what it costs.
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  /// CASCADE, matching `DesignWorkshopViewer.user` and `WorkshopAssignment.user` rather than the
  /// Restrict the consent log above carries. A usage row is not a record of anybody taking
  /// responsibility for anything — it is a meter reading — so it must never become a new reason an
  /// admin cannot delete an account.
  user User @relation("DwDictationDailyUsageUser", fields: [userId], references: [id], onDelete: Cascade)

  /// The pair IS the identity, and it serves the only read this table has: "how much has THIS
  /// designer spent TODAY". No second index and no scan — the same argument
  /// `DesignWorkshopViewer.@@id([designWorkshopId, userId])` makes, with the leading column chosen
  /// the same way, because every question starts with the user.
  @@id([userId, istDay])
}

/// One designer's AI-VERB spend on one India-time calendar day, broken down by verb.
///
/// The sibling of `DwDictationDailyUsage` above, deliberately modelled on it down to the string day
/// key so that a reader who knows one knows the other — and the day itself is computed by
/// `dictation_cap.ist_day` and by nothing else, because two definitions of "daily" is how a designer
/// ends up with two allowances or with none.
///
/// **WHY A SECOND TABLE RATHER THAN A `verb` COLUMN ON THE FIRST.** Adding one would change that
/// table's primary key, which is the identity a live feature reads on every dictation, and it would
/// merge two meters whose whole point is that they are separate: plan §6.1 scopes the dictation cap
/// to the transcription service alone, in the user's own words, so a caption must not be able to
/// exhaust it. A migration that reshapes a working meter to avoid creating an empty one is the wrong
/// trade.
///
/// THE VERB IS IN THE KEY THOUGH THE CEILING IS SHARED. The ceiling counts every verb together
/// because the bill does; the breakdown is kept because the first thing anybody asks when a cap is
/// hit is WHICH verb spent it, and a single counter can never answer that. It is also the only
/// measurement of what these verbs cost that this system will ever have — the same argument
/// `dictation_cap.spend` makes for counting while uncapped.
model DwAiVerbDailyUsage {
  userId String
  /// The SERVER's India-time calendar date as "YYYY-MM-DD" — see `DwDictationDailyUsage.istDay` for
  /// why a string, why IST, and why the handset's clock is not consulted.
  istDay String
  /// PROOFREAD / EXPAND / TRANSLATE / CAPTION / SUBTITLES, as `ai_verbs.Verb` spells them.
  ///
  /// A String and NOT a Postgres enum, unlike `DwAiLayerKind`, and the difference is what the value
  /// does. A kind is printed as a heading in a submitted document, so a typo there is a document
  /// defect and the database must refuse it. This is a meter label: a typo produces a wrong
  /// breakdown line and nothing else, and an enum here would mean a migration before anybody could
  /// meter a sixth verb — which is the friction that gets the meter left out instead.
  verb   String
  /// Runs that actually reached a provider. NOT incremented for a body refused before the call and
  /// NOT for the 503 that means no provider key is configured: neither spent anything, and charging
  /// a designer's allowance for the server's own misconfiguration is the one refusal they can do
  /// nothing whatever about. The identical rule, for the identical reason, as `dictation_cap.spend`.
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  /// CASCADE, matching `DwDictationDailyUsage.user`: a meter reading is not authorship and must
  /// never become a new reason an admin cannot delete an account.
  user User @relation("DwAiVerbDailyUsageUser", fields: [userId], references: [id], onDelete: Cascade)

  /// The triple IS the identity. Leading with the user for the sibling's reason — every question
  /// starts with the account — and the day before the verb because the allowance is scoped to the
  /// day and the verb is only ever the breakdown.
  @@id([userId, istDay, verb])
}

// ======================================================================================
// Peer and pool review: what one designer thought of one sketch or prototype
// ======================================================================================

/// WHICH AUDIENCE A RATING CAME FROM. The same two tokens as the registry's `REVIEW_ROUND`
/// controlled list (`stage_schema.ENUMS`), and `test_review_rating_ledger` asserts the two lists are
/// identical member for member — a token that exists on one side and not the other is a rating the
/// form can file and the aggregate cannot count, or the reverse.
///
/// A Postgres enum and not TEXT, on `DwDictationConsent`'s reasoning rather than
/// `DwAiVerbDailyUsage.verb`'s: this value is not a meter label whose typo costs a wrong breakdown
/// line. It decides WHICH POPULATION a mean score is taken over, so a row with a typo'd round is a
/// row that silently belongs to neither round and is dropped from both averages. Postgres refuses
/// the typo; TEXT would store it.
enum DwReviewRound {
  /// The people who were in the room: this workshop's designers, the master craftsperson, the
  /// artisans who made the thing. Runs while the workshop does.
  PEER
  /// Every designer on the platform, most of whom have never seen the cluster. Opens for one
  /// prototype on the day `prototype.peerRoundClosedAt` is set on it.
  POOL
}

/// One designer's rating of one sketch or one prototype, in one round.
///
/// WHY THIS CANNOT LIVE IN `DwStageEntry`, WHICH IS THE OBVIOUS-LOOKING HOME. Three independent
/// reasons and any one of them settles it:
///
///   1. A stage entry's answers are a JSON blob in a shared table, so ONE-RATING-PER-REVIEWER IS NOT
///      EXPRESSIBLE. A unique index cannot reach inside `data`, and enforcing it in the service is a
///      read-then-write with a network round trip in the middle — the same hole
///      `DwStageEntry.clientKey` documents on singleton rows, where two designers on one workshop
///      each found nothing and each inserted one.
///   2. THE REGISTRY'S `REF` TYPE CANNOT POINT AT AN ACCOUNT. `reference_options` resolves a REF
///      against the five `REFERENCE_MODELS` — Artisan, ProductDocumentation, ToolDocumentation,
///      Process, Craft — or against an entity of the same workshop, and `User` is in neither set. So
///      a reviewer stored in a stage entry could only ever be a typed-in name, and "who rated what"
///      would be answerable to a reader and not to a query.
///   3. THE POOL ROUND IS READ BY THE PEOPLE THE WORKSHOP DOOR TURNS AWAY. A `DwStageEntry` is
///      reachable only through `load_workshop_or_404`, which admits the creator, an admin and the
///      holder of a viewer grant — and which grants READ PLUS STAGE WRITES, because the stage save
///      routes go through that same helper. The pool round is by definition everybody else, so
///      serving it from inside the stage row would mean widening that helper, which would hand
///      every designer in the country write access to every finished workshop's 22 stages. The
///      ledger is a separate object behind a separate, narrower door
///      (`design_ratings.load_ratable_workshop_or_404`).
///
///      NOT because the pool read is cross-workshop — IT IS NOT, and an earlier draft of this
///      docstring said it was. `GET /design-ratings/rounds/{{round}}` requires a `workshopId` for
///      BOTH rounds, because the placed order is `DwStageEntry.ordinal` and an ordinal orders one
///      collection inside one workshop. Level 2 is the same list read by a wider audience.
///
/// MODELLED ON `DwWorkshopConsentDecision` for its shape, its onDelete rules and its two clocks, and
/// IT DIVERGES FROM IT IN ONE STATED WAY: that table is append-only and this one is not. Consent is
/// an event history because a withdrawal must not erase the answer nine sends were made under. A
/// rating is a CURRENT OPINION — a designer who moves a score from 3 to 4 has not made two
/// judgements, they have one — so the unique triple below makes the second filing an update of the
/// first, and `updatedAt` says when they last changed their mind. Ranking reads the opinion, never a
/// history of it.
///
/// THE READ PATH IS THE POINT AND IS NOT OPTIONAL. This repository already carries three ledgers
/// that are written and never read back — `ReviewLog` has two create sites and no reader, and both
/// decision tables above say "RECORDED, NOT YET SERVED" in as many words. That is tolerable for an
/// audit trail somebody can reach with psql; it is not tolerable here, because the ratings ARE the
/// feature: the default sort order of the review page is the mean of this column, and a table with
/// no reader would leave that page sorting by nothing. `test_review_rating_ledger` pins the pairing
/// rather than trusting it — the day any code in `app/` writes a row here, some code in `app/` has
/// to read one back or the suite fails.
model DwReviewRating {
  id String @id @default(cuid())

  /// The workshop the rated thing belongs to, denormalised off the stage entry.
  ///
  /// COPIED AND NOT JOINED, for the one read that cannot afford the join: "every rating filed in
  /// this workshop's peer round" is the level-1 review page, and without this column it is a join
  /// through `DwStageEntry` on every load. It is also what the CASCADE below probes. It is written
  /// from the stage entry at insert time and is never edited — a stage entry cannot move between
  /// workshops, so the two can never disagree.
  designWorkshopId String

  /// WHAT IS BEING RATED: the `DwStageEntry` row holding the sketch or the prototype.
  ///
  /// The row id and not `(workshop, entityKey, ordinal)`, because the ordinal is exactly the thing
  /// review CHANGES: a rating keyed on a position would follow the position rather than the object
  /// the moment anybody dragged the list, which is the one operation this whole feature exists to
  /// support.
  stageEntryId String

  /// `sketch` or `prototype`, copied from the entry so the round listing filters without the join —
  /// `workshop_ratings` names this column beside the workshop and the round.
  ///
  /// A String and not an enum, unlike `round` below, and deliberately. The list of rateable
  /// entities is `design_ratings.RATEABLE_ENTITIES` — a hard-coded `frozenset({"sketch",
  /// "prototype"})` that `load_subject` checks the entry against. It is NOT read off the registry
  /// today, so a sixth reviewable entity needs a Python edit whichever column type this is; the
  /// difference is what ELSE it needs. TEXT: a constant changes and the next deploy carries it.
  /// An enum: an ALTER TYPE has to land, in its own migration, BEFORE the code that writes the new
  /// token — a two-step ordering across a fleet that syncs late, for a value that is already
  /// constrained by the service on the way in. DERIVING THE SET FROM THE REGISTRY would make the
  /// TEXT choice load-bearing rather than merely cheap, and is the better end state; it is
  /// `design_ratings`' change to make, handed to that module's owner rather than made from here.
  entityKey String

  /// WHO RATED IT — a real foreign key and not a typed-in name, which is the whole reason this is a
  /// table. "Admins and master admins see who rated what, when and how; designers see the same for
  /// their own records only" is a predicate on this column, and a name column could not carry it.
  reviewerId String

  round DwReviewRound

  /// THE QUANTITATIVE HALF, on the registry's `QUALITY_RATING` scale of 1 to 5 — the same five
  /// tokens `prototypeValidation` already scores five separate qualities on, so a designer meets one
  /// scale on this feature and not two. The 1..5 bound is a CHECK constraint in the migration rather
  /// than a convention, because this column is AVERAGED: a stray 40 does not look wrong in a row,
  /// it looks wrong in every ranking the row is part of, and by then nobody is looking at rows.
  score Int

  /// THE QUALITATIVE HALF, and it is two columns because the owner asked for two things — designers
  /// "rate peers work qualitatively and quantitatively, leave suggestions". An assessment ("the
  /// joinery is cleaner than the sketch promised") and a proposed change ("try the narrower base")
  /// are different speech acts with different readers: the first belongs beside the score, the
  /// second belongs in the maker's list of what to do next. Collapsed into one box, the suggestions
  /// are unfindable inside the prose.
  ///
  /// Both optional. A score with no words is a legitimate rating and demanding a sentence for it is
  /// how a reviewer stops rating.
  comment    String?
  suggestion String?

  /// WHAT THE DEVICE SAID, as distinct from when this server heard it — `DwWorkshopConsentDecision`
  /// `.recordedAt`'s column, for its reason. A rating typed in a courtyard reaches the server on the
  /// next sync, which on this fleet can be a fortnight later; `createdAt` below is always when the
  /// row appeared here. NULL when the rating was filed straight against the server, where the two
  /// are the same moment and repeating it would add nothing.
  ///
  /// MILLISECONDS, AND WIDENING THE COLUMN DOES NOT CHANGE THAT — measured, because it looks like
  /// the fix and is not. A bare `DateTime` generates `TIMESTAMP(3)`, and this stays that way even
  /// though the replay rule wants an exact match: `design_ratings._is_stale_delivery` decides a
  /// REPLAY by `incoming <= stored`, so a redelivery of the identical capture is only recognised
  /// when the stored clock comes back equal to the one that was sent. It does not. A Python
  /// datetime carries microseconds; the Prisma query engine truncates a datetime to milliseconds
  /// on the way out, before Postgres is involved at all. `@db.Timestamp(6)` was tried here on
  /// 2026-08-22 and the column then stored `...053000` for every row — the microsecond digits
  /// arrive as zeroes whatever the column can hold, and the round-trip test stayed red. So the
  /// column matches the precision the client can actually deliver, and the comparison is what has
  /// to tolerate the truncation — that is `_is_stale_delivery`'s to do, and it is raised there.
  ratedAt DateTime?

  createdAt DateTime @default(now())
  /// When the reviewer last changed their mind. Present here and absent on the two decision tables
  /// above because those are append-only and this one is an upsert — see the model docstring.
  updatedAt DateTime @updatedAt

  /// CASCADE on both, matching every other design-workshop child table. Both fire on a HARD delete
  /// only: the API's workshop delete is a soft one and `save_stage` soft-deletes a removed row
  /// rather than dropping it, so an ordinary deletion leaves the ratings intact and a restore brings
  /// them back with the thing they are about.
  designWorkshop DesignWorkshop @relation("DesignWorkshopReviewRatings", fields: [designWorkshopId], references: [id], onDelete: Cascade)
  stageEntry     DwStageEntry   @relation("DwStageEntryReviewRatings", fields: [stageEntryId], references: [id], onDelete: Cascade)

  /// RESTRICT, exactly as `DwWorkshopConsentDecision.actor`, `DwAiLayerDecision.actor` and
  /// `ReviewLog.reviewer` are. This row says a named designer judged a colleague's work, and that
  /// judgement is shown to admins WITH THE NAME ON IT and is counted into the ranking the maker
  /// sees. An account deleted out from under it would leave a score in a ranking that nobody filed.
  /// Deleting such an account already fails on a dozen other relations, and the message the admin is
  /// shown degrades honestly for relations it cannot name (`_undeletable_detail` in
  /// api/routes/users.py).
  reviewer User @relation("DwReviewRatingReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  /// ONE PERSON, ONE THING, ONE ROUND — the constraint that stops a reviewer filing five ratings of
  /// the same sketch and quintupling their own weight in its mean. In the database and not in the
  /// service, because the service alone is a read-then-write and the offline case retries: a phone
  /// that syncs a rating twice over a flaky link is the ordinary way this happens, not the
  /// adversarial one.
  ///
  /// ROUND IS IN THE KEY BECAUSE THE SAME PERSON LEGITIMATELY RATES TWICE. A workshop's own designer
  /// is also a member of the pool, and their peer-round view of a prototype and their pool-round
  /// view of the finished thing are two different judgements of two different objects. Leaving
  /// round out would silently discard the second.
  ///
  /// IT IS ALSO THE READ INDEX FOR ONE OBJECT'S RATINGS. Leading with `stageEntryId` means the
  /// aggregate behind the default sort — every rating of this sketch — is a prefix probe of this
  /// same btree, and the CASCADE from `DwStageEntry` uses it too. No second index is added for
  /// either, on `DwDictationDailyUsage`'s stated reasoning: an index nothing probes is a write cost
  /// with no read behind it.
  @@unique([stageEntryId, reviewerId, round])

  /// THE ROUND LISTING, COLUMN FOR COLUMN: `design_ratings.workshop_ratings` is
  /// `where={designWorkshopId, entityKey, round}`, which is exactly these three equality
  /// predicates, and it is the one query behind every render of the review tab. The leading column
  /// is also what the workshop CASCADE probes, so this index does two jobs — the same double duty
  /// `DwWorkshopConsentDecision_designWorkshopId_createdAt_idx` does.
  @@index([designWorkshopId, entityKey, round])

  /// THE RESTRICT ABOVE, AND NOTHING ELSE — indexed for the WRITE it is on the wrong end of rather
  /// than for any read, exactly as `DwWorkshopConsentDecision`'s index on (actorId) is. Deleting a
  /// user makes Postgres look for a rating naming them, on every account deletion, and without this
  /// that is a sequential scan.
  ///
  /// NO `createdAt` BESIDE IT, and no per-reviewer index at all, because NOTHING QUERIES BY
  /// REVIEWER. "Who rated what, when" looks like a per-reviewer read and is not one: `visible_rows`
  /// takes the round's rows and filters them in Python, and the only reviewer-keyed probe
  /// (`existing_rating`'s `find_first` — NOT `rating_plan`, which is a pure planner and issues no
  /// query at all) also names `stageEntryId` and so rides the unique index above.
  /// A composite here would be a write cost with no read behind it — `DwDictationDailyUsage`'s
  /// stated rule, applied to the case it was written for.
  @@index([reviewerId])

  /// NO CROSS-WORKSHOP INDEX, and the reason is a property of the feature rather than an omission.
  /// The pool round reads no wider than the peer round does: `GET /design-ratings/rounds/{round}`
  /// requires a `workshopId` for BOTH rounds, because the placed order is `DwStageEntry.ordinal`
  /// and an ordinal orders one collection inside one workshop — two prototypes in two workshops are
  /// both ordinal 0, so a mixed list has no arrangement anywhere to be stored. Level 2 is therefore
  /// THE SAME LIST READ BY A WIDER AUDIENCE, not a wider list, and every read of this table is
  /// scoped by workshop or by subject. An index on `round` leading would have nothing to probe it.
  ///
  /// If a cross-workshop BROWSE is ever built — a different feature, as that route's docstring says
  /// — it needs an index on (round, entityKey, createdAt) and it needs it for
  /// `DwStageEntry`'s index on (entityKey)'s stated reason: a read whose cost grows with the archive
  /// rather than with the answer. It is deliberately NOT added ahead of the query that would use it.
}

// ======================================================================================
// The designer: who may sign in as one, and what the app already knows about them
// ======================================================================================

/// The institution's roster of recognised designers. A DESIGNER account may sign in only while an
/// ACTIVE row here carries its email.
///
/// TWO SEPARATE FACTS, DELIBERATELY. `User.role` says what somebody may DO; this table says whether
/// the institution still recognises them at all. Collapsing the two into the role column would mean
/// removing a departed designer's access by demoting them, which silently rewrites the authorship of
/// every workshop they ran — the role is read when deciding who may review whose work, so a
/// demotion is retroactive. Revoking a roster row ends the sessions and leaves the record intact.
///
/// Admin and above may edit the roster; nobody else may read it, because it is a list of named
/// individuals and their institutional standing.
///
/// NOT THE PLATFORM ALLOW-LIST — see `AccessRoster`, which is. This table means "empanelled as a
/// designer", which is a stronger and narrower claim than "may sign in at all": an ACTIVE row here
/// PROMOTES a new or lower-ranked account to DESIGNER on its first Google sign-in. The platform
/// gate was deliberately NOT built by widening this table, because grandfathering every existing
/// account into it — which the requirement demands — would have handed the DESIGNER role to every
/// volunteer in the product at their next sign-in, and would have blown `active_roster_emails`
/// past a cap sized for one row per empanelled designer.
model DesignerRoster {
  id    String @id @default(cuid())
  /// Lower-cased on write. The join key to User.email, which is itself unique — but this row may
  /// exist BEFORE the account does, which is the point: an admin adds the designer to the roster
  /// and the account provisions itself on first Google sign-in.
  email String @unique
  /// The name the admin entered, used to seed the account when it first appears and to show a
  /// meaningful roster before anyone has signed in.
  fullName    String?
  institution String?
  /// Free-text note from the admin: which programme this designer was empanelled under, and when.
  notes       String?

  /// False suspends sign-in without deleting the history of the empanelment. Preferred over
  /// deleting the row, which would leave no record that the person was ever recognised.
  isActive  Boolean   @default(true)
  revokedAt DateTime?
  /// Set the first time an account with this email signs in, so an admin can see which invitations
  /// are outstanding rather than guessing.
  firstSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  addedById String?
  addedBy   User?    @relation("DesignerRosterAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([addedById])
}

/// A designer's standing details, entered once and reused by every report they generate.
///
/// The reason this exists is in the requirement: a designer should not retype their institution,
/// qualification and biography into stage 1 and stage 3 of every workshop they run. The profile is
/// the source, and `prefill_designer_fields` copies it into a new workshop's stages — copies, not
/// references, because a report is a historical document: if the designer moves institutions in
/// 2027, the workshop they ran in 2026 must still name the institution they ran it from.
///
/// Editable by the owner and by admins, and by nobody else. A designer correcting their own
/// biography needs no approval; another designer editing it is not a thing that should be possible.
model DesignerProfile {
  id     String @id @default(cuid())
  userId String @unique

  displayName    String?
  /// Written in the local script where the designer wants it that way; printed verbatim.
  localName      String?
  designation    String?
  institution    String?
  department     String?
  qualification  String?
  specialisation String?
  experienceYears Int?
  /// The paragraph that appears as "Designer's profile" in stage 3 of every report.
  biography      String?
  phone          String?
  email          String?
  website        String?
  addressLine    String?
  city           String?
  state          String?
  pincode        String?
  /// Media ids, resolved through MediaFile exactly as a stage field's photo is.
  photoMediaId     String?
  signatureMediaId String?

  /// Empanelment identifiers a government report is expected to carry.
  empanelmentNo   String?
  empanelmentDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("DesignerProfileUser", fields: [userId], references: [id], onDelete: Cascade)
}

// ======================================================================================
// The platform allow-list: who may sign in AT ALL, and the queue of people asking to
// ======================================================================================

/// Where an email stands with respect to signing in at all. See `AccessRoster`.
///
/// FOUR STATES AND NOT A BOOLEAN, because the four are answered with four different sentences and
/// three different remedies. A person who is waiting on an admin, a person an admin turned down, a
/// person whose access was ended after they had it, and a person who is in — collapsed into
/// `isActive` those are one refusal, and the one thing every one of them would then be told is the
/// thing that is true of none of them.
enum AccessStatus {
  /// May sign in. The only value that admits.
  ACTIVE
  /// Asked (by attempting to sign in) and not yet decided. This is the notification queue.
  PENDING
  /// An admin said no. A re-attempt does NOT move this back to PENDING — see the service module.
  REJECTED
  /// Had access, an admin ended it. Distinct from REJECTED so the roster keeps saying which
  /// decision was actually taken; an admin reading "rejected" on somebody who worked here for two
  /// years has been told something false.
  SUSPENDED
}

/// THE PLATFORM ALLOW-LIST. One row per email that has ever been admitted to, or asked to be
/// admitted to, this application. `auth.login` refuses every account that has no ACTIVE row here —
/// every account but the master admin's, which is exempt.
///
/// **KEYED BY EMAIL, NOT BY USER ID, AND THAT IS THE POINT.** It is `DesignerRoster`'s design and
/// it is kept for the same two reasons: an admin can admit somebody BEFORE their account exists
/// (there is no invitation email in this product, so the row is the invitation), and a request from
/// a Google identity with no account can be recorded without creating the account that recording it
/// would otherwise imply. A user-id foreign key could express neither.
///
/// **WHY THIS IS NOT A STATUS COLUMN ON `DesignerRoster`.** That table already means something
/// stronger — "empanelled as a designer" — and an ACTIVE row in it promotes the account to DESIGNER
/// on first Google sign-in. Grandfathering every existing account into it, which the requirement
/// requires, would therefore have promoted every crowdsource volunteer in the product to DESIGNER
/// at their next sign-in: a privilege escalation delivered by the migration that was supposed to
/// change nothing. It would also have taken `active_roster_emails` — one full-table read capped at
/// a number chosen for "one row per empanelled designer" — past its cap, silently dropping eligible
/// designers out of the viewer picker and the designer directory. The two tables cooperate instead:
/// an ACTIVE `DesignerRoster` row is accepted as an admission here and writes itself an ACTIVE row
/// on the way through, so an admin who empanels a designer has still done everything needed.
///
/// **NOTHING AN ATTACKER CONTROLS IS STORED HERE BEYOND THE ADDRESS.** A row is only ever created
/// after an identity proof — a bcrypt-verified password against an existing account, or a Google ID
/// token verified against the configured audience — so an anonymous caller cannot enqueue an
/// address they do not hold. `fullName` and `notes` are ADMIN-typed only and are never populated
/// from a Google profile: the requirement's "notification" surface is a list an admin reads, and a
/// display name lifted from an unverified source is a place to put a phishing sentence.
model AccessRoster {
  id String @id @default(cuid())
  /// Lower-cased on write, by `app/services/access_roster.py:normalise_email` and nowhere else.
  /// Joined to `User.email`, which is NOT lower-cased on that side — every comparison against it
  /// therefore lower-cases both. A row typed `A.Sharma@Example.org` that never matches the account
  /// signing in as `a.sharma@example.org` is a person locked out of the app by a capital letter,
  /// with an admin looking straight at the row that was supposed to let them in.
  email  String       @unique
  status AccessStatus @default(PENDING)

  /// The tier a NEW account for this address is created at, and the tier an existing lower-ranked
  /// account is lifted to, when this row admits. NULL means `DEFAULT_SIGNUP_ROLE` — the lowest rung,
  /// which is the documented default for this platform ("all users join as the lowest rung unless
  /// promoted"). An admin approving a request may set it higher, up to their own tier.
  ///
  /// LIFTS, NEVER LOWERS. Applied through a strictly-below rank comparison, for `login_with_google`'s
  /// reason: an admin whose row says CROWDSOURCE_VOLUNTEER because nobody ever edited it must not be
  /// demoted by their own next sign-in.
  admitRole UserRole?

  /// **THE DATE OF JOINING THE PLATFORM**, which the requirement asks the admin screen to show.
  ///
  /// Its own column rather than a read of `User.createdAt`, and the migration backfills it FROM
  /// `User.createdAt` so nothing is invented for the accounts that predate this table. Three things
  /// `User.createdAt` cannot answer: a row admitted before any account exists has no user row to
  /// read; an account deleted and recreated would report the second creation as the joining date
  /// while this row remembers the first; and after this table exists, joining the platform is the
  /// admission decision, which is not the same event as the account row appearing.
  joinedAt DateTime?

  /// When this address first asked. Set on the transition into PENDING and never moved, so the
  /// queue can be worked oldest-first and "how long has this person been waiting" is answerable.
  requestedAt DateTime?
  /// Refused sign-in attempts by a proven identity for this address, and the latest one. THE BOUND
  /// ON A WRITE NO SIGNED-IN USER MADE: one person hammering the form is one row with a rising
  /// count, not a row per attempt. An admin reads the count as "this person is still trying", which
  /// is the one useful thing about a repeat attempt.
  attemptCount  Int       @default(0)
  lastAttemptAt DateTime?

  /// Who decided, and when. NULL on a row nobody has decided yet, and on the grandfathered rows —
  /// which is honest: no admin approved the accounts that predate the gate, the migration admitted
  /// them wholesale, and `notes` says so.
  decidedAt   DateTime?
  decidedById String?
  decidedBy   User?     @relation("AccessRosterDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  /// First SUCCESSFUL sign-in after admission. Answers "did the person we approved ever actually
  /// arrive" — an invitation that never reached them looks exactly like one that was ignored.
  firstSeenAt DateTime?

  /// Admin-typed, both of them. Never written from a login attempt. See the model docstring.
  fullName String?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  addedById String?
  addedBy   User?    @relation("AccessRosterAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  /// The pending count on the admin surfaces is `count(where status = PENDING)` and it is read on
  /// every page load of several screens, so it gets an index of its own. The composite serves the
  /// queue itself, which is ordered oldest-request-first.
  @@index([status])
  @@index([status, requestedAt])
  @@index([addedById])
  @@index([decidedById])
}
