// Many-to-many between a tool and the artisans who use it. Lets one documented tool be assigned to
// several artisans (across the same or different crafts) instead of re-entering the tool per craft.
model ToolArtisan {
  id        String   @id @default(cuid())
  toolId    String
  artisanId String
  createdAt DateTime @default(now())

  tool    ToolDocumentation @relation(fields: [toolId], references: [id], onDelete: Cascade)
  artisan Artisan           @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  // No [toolId] of its own — it is the leading column of the unique below, which serves the
  // tool-to-artisans lookup already.
  @@unique([toolId, artisanId])
  @@index([artisanId])
}

model MediaFile {
  id               String       @id @default(cuid())
  originalFilename String
  mediaType        MediaType
  mimeType         String
  sizeBytes        BigInt
  bucket           String
  objectKey        String       @unique
  url              String?
  caption          String?
  checksum         String?
  transcriptText   String?
  transcriptSummary String?
  transcriptStatus String?
  transcriptError  String?
  linkedRecordType String?
  linkedRecordId   String?
  status           RecordStatus @default(PENDING)
  reviewNotes      String?
  reviewedById     String?
  reviewedAt       DateTime?
  extraMetadata    Json?
  recordedAt       DateTime     @default(now())
  recordedTimezone String       @default("Asia/Kolkata")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  uploadedById     String
  artisanId        String?
  craftId          String?
  workshopId       String?
  productId        String?
  toolId           String?
  questionnaireInterviewId String?
  locationId       String?

  uploadedBy User                  @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  artisan    Artisan?              @relation(fields: [artisanId], references: [id], onDelete: SetNull)
  craft      Craft?                @relation(fields: [craftId], references: [id], onDelete: SetNull)
  workshop   Workshop?             @relation(fields: [workshopId], references: [id], onDelete: SetNull)
  product    ProductDocumentation? @relation(fields: [productId], references: [id], onDelete: SetNull)
  tool       ToolDocumentation?    @relation(fields: [toolId], references: [id], onDelete: SetNull)
  questionnaireInterview QuestionnaireInterview? @relation("QuestionnaireMedia", fields: [questionnaireInterviewId], references: [id], onDelete: SetNull)
  location   Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  processingJobs MediaProcessingJob[]
  /// The layers derived FROM this file — the raw rung of both chains. `transcriptText` above stays
  /// exactly as it is and stays the queue's business: this is the copy that carries which model
  /// produced it, which that column has never had room to say. See DwAiLayer.
  aiLayers   DwAiLayer[]           @relation("MediaFileAiLayers")

  @@index([mediaType])
  @@index([uploadedById])
  @@index([linkedRecordType, linkedRecordId])
  @@index([createdAt])
  @@index([status])
  // The parent foreign keys. These are not for `where` clauses a route writes by hand — they are for
  // the reverse walk `include: {media: true}` generates, which Prisma issues as a separate
  // `WHERE "<fk>" IN (…the page's 20 parents…)`. craftId and questionnaireInterviewId were indexed;
  // artisanId, productId and toolId were not, so the products and tools lists each sequentially
  // scanned the whole of the largest table in the database once per page.
  @@index([craftId])
  @@index([questionnaireInterviewId])
  @@index([artisanId])
  @@index([productId])
  @@index([toolId])
  // Composite rather than bare workshopId: a workshop's media is the one parent set big enough that
  // the data browser's `ORDER BY createdAt` over it is worth serving from the index too.
  @@index([workshopId, createdAt])
}

model MediaProcessingJob {
