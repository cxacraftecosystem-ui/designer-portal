<?xml version="1.0" encoding="utf-8"?>
<!-- `xmlns:tools` is declared for the two `tools:ignore="AppLinkUrlError"` attributes on the
     questionnaire-receiving VIEW filters near the bottom of this file. It is a build-time namespace:
     the tools attributes are stripped from the merged manifest and reach no device. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Reading whether there is a usable network, which this app has always done and has never
         declared. `ConnectivityObserver.isOnline` (data/Offline.kt) calls `getActiveNetwork` and
         `getNetworkCapabilities`, and `DwInductionFlusher` now also calls
         `registerDefaultNetworkCallback`; all three require this permission. It has been arriving by
         manifest merge from a transitive library, which is the same defect the two undeclared test
         dependencies in `backend/pyproject.toml` are documented for — it works on every build anybody
         has made and nothing in this repository asks for it, so a dependency change can remove it and
         the symptom is a SecurityException in the offline queue.

         A NORMAL permission: not requested at runtime, not shown in the install dialog, no prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Over-the-air self-update: install the APK the master admin pushed. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Saving a report/dataset into the public Downloads folder, on API 26-28 ONLY.

         On Q and above `persistFileToDownloads` writes through MediaStore, which needs no permission
         at all. Below Q there is no MediaStore.Downloads collection, so the only public Downloads
         folder is a raw path under external storage — and writing there without this permission
         throws SecurityException. minSdk is 26, so 26/27/28 devices really do take that branch: every
         "Save report" on an Android 8 or 9 handset (which is most of the field fleet) crashed the
         export with no message a designer could act on.

         maxSdkVersion="28" is not decoration. Left uncapped, the permission stays in the manifest on
         Q+ where scoped storage makes it a no-op that Play still flags and that users see in the
         install dialog as "Photos and files" — a scary prompt in exchange for nothing. Capped, the
         platform strips it entirely above 28, so it exists exactly on the API levels that need it.
         It is requested at runtime alongside the other dangerous permissions (see
         requiredAndroidPermissions in MainActivity.kt); the declaration alone grants nothing on 26+. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Transport: TLS-only. The real policy lives in res/xml/network_security_config.xml (which
         takes precedence on every supported API level, minSdk 26); usesCleartextTraffic="false"
         states the same intent for the platform APIs that read the manifest flag directly. The
         emulator/loopback development hosts stay reachable over HTTP via that file's domain-config. -->
    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.DesignWorkshop"
        android:usesCleartextTraffic="false">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Starts the offline induction flush at process start. IT STORES AND SERVES NOTHING.

             A provider declared here is instantiated by the platform before the first activity, which
             is the earliest ordinary place code can run in an app with no `Application` subclass —
             the same mechanism `androidx.startup` and WorkManager use, and the reason this is a
             provider rather than a hook in `MainActivity`. See `ui/DwInductionFlusher.kt`: a card
             scanned with no signal has to be sent when signal RETURNS, not when somebody happens to
             reopen the scanner, and `dwJoinQueuedMessage` promises exactly that.

             `exported="false"` and every data method answers null/0, so this adds no API surface. The
             authority is namespaced under the application id so two builds can be installed side by
             side without the "provider authority already in use" install failure. -->
        <provider
            android:name="com.designprototype.workshop.ui.DwInductionFlushProvider"
            android:authorities="${applicationId}.inductionflush"
            android:enabled="true"
            android:exported="false" />
        <!--
          singleTop below IS LOAD-BEARING for the SEND/VIEW filters this activity now carries. This is
          a single-activity Compose app: every screen, the signed-in user and the whole navigation
          stack live in one Activity's composition. Under the default "standard" mode a questionnaire
          arriving from another phone while the app was already open would build a SECOND MainActivity
          on top of the first — a second copy of that state, with `onNewIntent` never called, so the
          delivery would be read by an instance the designer then backs out of. singleTop routes it
          into the running instance instead, which is what makes `onNewIntent` the place the file is
          picked up.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              AN ADMINISTRATOR'S SET-PASSWORD LINK, TAPPED IN A CHAT APP.

              Until this existed the only route into `SetPasswordLinkScreen` was the paste box on the
              sign-in card: a designer who cannot sign in receives a link, taps it, lands in a
              browser, and has to come back, open the app, find "I have a set-password link" and
              paste. This filter puts the app on the chooser for that tap, and `takePasswordLink` in
              `MainActivity.kt` drops the whole URL into that box so the check fires immediately.

              ⚠ THIS IS A PLAIN FILTER AND **NOT** A VERIFIED APP LINK. There is no
              `android:autoVerify="true"` below and the absence is deliberate, not an oversight:

                WHAT IS SHIPPED. Android shows a disambiguation dialog — this app beside the
                browser — and the person chooses. Nothing is taken away from the browser, which
                still works and is still the route for anybody who does not have the app.

                WHAT A VERIFIED LINK WOULD OWE, and every item is a DEPLOYMENT obligation rather
                than a code change here:

                 1. `https://<the web origin>/.well-known/assetlinks.json`, served from that exact
                    host over HTTPS, 200, `Content-Type: application/json`, with NO redirect —
                    Google's verifier follows none — naming `com.designprototype.workshop` and the
                    SHA-256 fingerprint of the certificate the installed APK is signed with.
                 2. THAT FINGERPRINT CANNOT BE WRITTEN DOWN FROM THIS REPOSITORY. The release
                    keystore is supplied through a local property and is not in the tree (see
                    `android/app/build.gradle.kts`), so the value has to come from `keytool -list -v`
                    on the actual keystore, or from Play's App Signing page if Play ever re-signs.
                    A file listing the wrong fingerprint does not fail loudly: verification simply
                    does not happen and the link silently degrades to this chooser.
                 3. EVERY FINGERPRINT, not one. A fleet running APKs signed with the debug key
                    (`debugSignRelease=true` builds one) needs that certificate in the file too, or
                    those handsets are the ones that do not verify.
                 4. Verification is attempted at INSTALL time. Publishing the file after the fleet has
                    updated verifies nothing until the next install.

                AND THE HOST BELOW IS THE PART TO CHECK FIRST IF A TAP DOES NOT OFFER THE APP.
                `credential_links.link_for` builds every link from the backend's `NEXT_PUBLIC_APP_URL`,
                whose default in `app/core/config.py` is `http://localhost:3000`. The deploy workflow
                pins `BACKEND_CORS_ORIGINS` on the server and does NOT pin that variable, so the value
                a live link carries lives in the `BACKEND_ENV` secret and cannot be read from this
                tree. The origin named here is the production web app documented in
                `docs/ENVIRONMENT.md` and admitted by that pinned CORS list. If the two ever differ,
                this filter matches nothing — which costs nothing and delivers nothing.

              `BROWSABLE` IS CORRECT HERE AND WRONG ON THE FILTERS BELOW. It means "a web browser or
              a chat app may hand this app a link", which is exactly what this is; the questionnaire
              VIEW filters are a file arriving from a file manager and carry no host, which is why
              they carry `tools:ignore="AppLinkUrlError"` and this one does not need it. `path` and
              not `pathPrefix`: this is one screen, and a prefix would put the app on the chooser for
              any longer path that happens to start with these characters.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="designer-repository.vercel.app"
                    android:path="/set-password" />
            </intent-filter>

            <!--
              RECEIVING A QUESTIONNAIRE FROM ANOTHER PHONE, with no internet at either end.

              Until this existed the app could only SEND. A colleague's Quick Share or Bluetooth push
              landed in Downloads and this app never heard about it, so the designer had to remember
              the file, open the questionnaire list and re-find it through the document picker. These
              filters add a direct door for the deliveries they can match, at the cost of no
              permissions and no APK bytes: the OS owns the radios, so the app declares nothing about
              Bluetooth or wifi at all.

              ⚠ THEY ARE NOT THE WHOLE OF NEARBY SHARE OR BLUETOOTH, which is what this comment used
              to claim. Quick Share and Bluetooth OPP save the file and hand over a Uri like
              content://media/external/downloads/1234 or content://com.android.bluetooth.opp/btopp/12,
              whose PATH carries no extension — so the pathPattern below misses — and the receiving
              MediaStore guesses the type from an unknown .dpwq extension, so the custom-subtype
              filter misses as well. For those two transports the app is not offered as a handler. The
              filters DO fire for a DocumentsUI-backed open (/document/primary:Download/x.dpwq matches
              once decoded) and for a file this app exported and shared itself.

              The remedy is the document picker in the receiving card, which is the MAIN door for
              nearby share and Bluetooth rather than a fallback, validates identically, and works with
              no signal. Dropping the path gate below is not an alternative: it would put this app on
              the "open with" list for every unrecognised file on the phone. See
              `isQuestionnaireBundleDelivery` for the same argument at more length.

              THE SPLIT BETWEEN THE FILTERS IS DELIBERATE and the reasoning is written out at
              `isQuestionnaireBundleDelivery`, which mirrors it exactly so that what the OS offers and
              what the app accepts cannot drift apart:

                SEND — our own subtype ONLY. A share sheet is a menu a person reads; putting this app
                on it for `application/octet-stream` would add a wrong entry for everybody who ever
                shares an unrecognised file, which is a cost paid by people who will never use this
                feature.

                VIEW — the broad types as well, but gated on a `.dpwq` path. Opening a file is already
                aimed at one specific file, so the extension is evidence there rather than noise. This
                is what catches a DocumentsUI open of a file whose type a provider did not recognise.

              NEITHER FILTER IS VALIDATION. The type string is set by whichever app is sending, so it
              is untrusted like the rest of the delivery. What a file actually is gets decided by
              `readQuestionnaireBundle` reading the bytes.

              No exported="true" change and no new permission: the activity is already exported for
              LAUNCHER, and receiving a file needs neither storage nor Bluetooth permission because
              the sender hands over a Uri with a read grant attached.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.designprototype.questionnaire+gzip" />
            </intent-filter>
            <!--
              NO `BROWSABLE` ON EITHER VIEW FILTER, and it was on both until lint said so. BROWSABLE
              means "a web browser may hand this app a link", which is not what receiving a file is:
              a file manager, a DocumentsUI open and a download notification all send VIEW under
              DEFAULT. Declaring it bought nothing, made the activity a candidate for
              browser-originated intents, and raised `AppLinkUrlError` twice — a BROWSABLE VIEW filter
              with no host is exactly what that check is for. Removing it loses no delivery.
            -->
            <!--
              `tools:ignore="AppLinkUrlError"` — NOT a suppressed real problem. That check exists for
              App Links: a VIEW filter meant to open `https://…` needs a scheme and a host, and lint
              applies the rule to EVERY VIEW+DEFAULT filter carrying a `<data>` element. This filter
              matches by MIME TYPE, on a Uri handed over by whichever app is sending the file. There
              is no host to name and no web address involved, so the check's advice cannot be
              followed, and adding a host would be inventing one. Scoped to these two filters rather
              than baselined or disabled project-wide, so a genuine App Link added later is still
              checked.
            -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.designprototype.questionnaire+gzip" />
            </intent-filter>
            <!--
              The same VIEW door for a provider that did not recognise our bytes. `pathPattern` needs
              the doubled backslash: the manifest unescapes one, leaving `\.` for the matcher, which
              is what keeps the dot literal rather than "any character".

              `file` is declared beside `content` for form's sake only: passing a file:// Uri between
              apps has thrown FileUriExposedException since API 24 and minSdk here is 26, so nothing
              a modern sender does can arrive on it. It costs nothing and is left rather than removed
              so that an ancient file manager on an Android 8 handset is not newly refused.
            -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/x-gzip" />
                <data android:pathPattern=".*\\.dpwq" />
                <data android:pathPattern=".*\\..*\\.dpwq" />
            </intent-filter>
        </activity>
    </application>
</manifest>
