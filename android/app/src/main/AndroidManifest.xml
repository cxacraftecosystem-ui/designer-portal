<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Over-the-air self-update: install the APK the master admin pushed. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Saving a report/dataset into the public Downloads folder, on API 26-28 ONLY.

         On Q and above `persistFileToDownloads` writes through MediaStore, which needs no permission
         at all. Below Q there is no MediaStore.Downloads collection, so the only public Downloads
         folder is a raw path under external storage — and writing there without this permission
         throws SecurityException. minSdk is 26, so 26/27/28 devices really do take that branch: every
         "Save report" on an Android 8 or 9 handset (which is most of the field fleet) crashed the
         export with no message a designer could act on.

         maxSdkVersion="28" is not decoration. Left uncapped, the permission stays in the manifest on
         Q+ where scoped storage makes it a no-op that Play still flags and that users see in the
         install dialog as "Photos and files" — a scary prompt in exchange for nothing. Capped, the
         platform strips it entirely above 28, so it exists exactly on the API levels that need it.
         It is requested at runtime alongside the other dangerous permissions (see
         requiredAndroidPermissions in MainActivity.kt); the declaration alone grants nothing on 26+. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Transport: TLS-only. The real policy lives in res/xml/network_security_config.xml (which
         takes precedence on every supported API level, minSdk 26); usesCleartextTraffic="false"
         states the same intent for the platform APIs that read the manifest flag directly. The
         emulator/loopback development hosts stay reachable over HTTP via that file's domain-config. -->
    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.DesignWorkshop"
        android:usesCleartextTraffic="false">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
